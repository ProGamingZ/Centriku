<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Centriku.ViewModels"
             xmlns:settingsViews="using:Centriku.Views.Settings"
             x:Class="Centriku.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
             
    <Grid RowDefinitions="Auto, *">
        
        <StackPanel Grid.Row="0" Margin="40,30,40,10">
            <TextBlock Text="Application Settings" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
            <TextBlock Text="Configure how Centriku handles and imports your data." Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="0,-5,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="30,10,40,40" SelectedIndex="{Binding SelectedTabIndex}">
            
            <TabItem Header="General" FontSize="16" FontWeight="SemiBold">
                <Grid>
                    <TextBlock Text="⚙️ General Settings (Coming Soon)" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                </Grid>
            </TabItem>
            
            <TabItem Header="Import" FontSize="16" FontWeight="SemiBold">
                <settingsViews:ImportSettingsView DataContext="{Binding ImportSettings}" Margin="10,20,10,10"/>
            </TabItem>

            <TabItem Header="Export" FontSize="16" FontWeight="SemiBold">
                <Grid>
                    <TextBlock Text="📤 Export Settings (Coming Soon)" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                </Grid>
            </TabItem>
            
        </TabControl>
        
    </Grid>
</UserControl>