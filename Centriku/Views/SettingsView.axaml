<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Centriku.ViewModels"
             xmlns:settingsViews="using:Centriku.Views.Settings"
             x:Class="Centriku.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
             
    <Grid RowDefinitions="Auto, *">
        
        <StackPanel Grid.Row="0" Margin="24,20,24,10">
            <TextBlock Text="Application Settings" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
            <TextBlock Text="Configure system storage, bulk import mappings, and spreadsheet export rules." Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="24,0,24,20" SelectedIndex="{Binding SelectedTabIndex}">
            
            <TabItem Header="System &amp; Storage" FontSize="16" FontWeight="SemiBold">
                <settingsViews:SystemSettingsView DataContext="{Binding SystemSettings}" Margin="0,12,0,0"/>
            </TabItem>
            
            <TabItem Header="Import" FontSize="16" FontWeight="SemiBold">
                <settingsViews:ImportSettingsView DataContext="{Binding ImportSettings}" Margin="0,12,0,0"/>
            </TabItem>

            <TabItem Header="Export" FontSize="16" FontWeight="SemiBold">
                <settingsViews:ExportSettingsView DataContext="{Binding ExportSettings}" Margin="0,12,0,0"/>
            </TabItem>

        </TabControl>
        
    </Grid>
</UserControl>