<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Centriku.ViewModels"
             x:Class="Centriku.Views.MyClassesView"
             x:DataType="vm:MyClassesViewModel"
             x:Name="RootControl">

    <Grid RowDefinitions="Auto, *">
        
        <StackPanel Grid.Row="0" Margin="40,30,40,20">
            <TextBlock Text="My Classes" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
            <TextBlock Text="Select a class below to manage students and open the gradebook." 
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" FontSize="14"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="40,10,40,30">
            <ItemsControl ItemsSource="{Binding ActiveClasses}">
                
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="25" 
                                Margin="0,0,25,25" 
                                Width="320"
                                BoxShadow="{DynamicResource ElevationLow}">
                            
                            <Grid RowDefinitions="Auto, Auto, *, Auto">
                                
                                <Grid Grid.Row="0">
                                    <Panel HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource PrimaryBrush}" Opacity="0.1" CornerRadius="6"/>
                                        <TextBlock Text="{Binding AcademicYear}" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" Margin="10,4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Panel>
                                    
                                    <TextBlock Classes="Icon" Text="{StaticResource IconClasses}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    
                                </Grid>
                                
                                <TextBlock Grid.Row="1" Text="{Binding SubjectName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,20,0,5" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Text="{Binding SectionLabel}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,30"/>
                                
                                <Button Grid.Row="3" 
                                        Command="{Binding #RootControl.((vm:MyClassesViewModel)DataContext).OpenClassCommand}"
                                        CommandParameter="{Binding}"
                                        Content="Open Gradebook →" 
                                        Background="Transparent" 
                                        Foreground="{DynamicResource PrimaryBrush}" 
                                        FontWeight="SemiBold" 
                                        HorizontalAlignment="Right"
                                        Padding="10,5"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>