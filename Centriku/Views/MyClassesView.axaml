<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Centriku.ViewModels"
             x:Class="Centriku.Views.MyClassesView"
             x:DataType="vm:MyClassesViewModel"
             x:Name="RootControl">

    <Grid>
        <!-- MAIN CONTENT -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto, Auto, Auto, *">
                <!-- Keep all your existing grid content here (StackPanel, Grid, Border, ItemsControl) exactly as it is -->
                
                <StackPanel Grid.Row="0" Margin="40,30,40,20">
                    <TextBlock Text="My Classes" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                    <TextBlock Text="Manage your workload and assign grading policies to your subjects." 
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="40,0,40,20">
                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Added Search Icon hint in placeholder -->
                            <TextBox Text="{Binding SearchQuery}" PlaceholderText="Search subjects or sections..." Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8" Padding="15,10" Width="300" Margin="0,0,15,0"/>
                            
                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Academic Year" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding AvailableYearFilters}" SelectedItem="{Binding SelectedYearFilter}" Background="{DynamicResource AppBackground}" Width="130"/>
                            </StackPanel>
                            
                            <StackPanel>
                                <TextBlock Text="Term" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding AvailableTermFilters}" SelectedItem="{Binding SelectedTermFilter}" Background="{DynamicResource AppBackground}" Width="130"/>
                            </StackPanel>
                        </WrapPanel>

                        <Button Grid.Column="1" Command="{Binding ToggleAddClassFormCommand}" 
                                Content="+ Add New Class" 
                                Background="{DynamicResource PrimaryBrush}" 
                                Foreground="White" FontWeight="Bold" 
                                CornerRadius="8" Padding="20,10" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Dashboard Consistency: Horizontal Separator -->
                    <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                </StackPanel>

                <Border Grid.Row="2" IsVisible="{Binding IsAddingClass}" 
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" CornerRadius="8" Padding="20" Margin="40,0,40,30">
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto">
                        <TextBlock Text="Class Details" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,15" Grid.Row="0"/>
                        
                        <!-- Row 1: Course Identity -->
                        <Grid Grid.Row="1" ColumnDefinitions="2*, 1*, 1*" Margin="0,0,0,15">
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Course Code &amp; Title*" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewSubjectName}" PlaceholderText="e.g. CS101 Mobile Prog" Background="{DynamicResource AppBackground}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                <TextBlock Text="Program" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewProgram}" PlaceholderText="e.g. BSCS" Background="{DynamicResource AppBackground}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Section Label" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewSectionLabel}" PlaceholderText="e.g. 3A" Background="{DynamicResource AppBackground}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Scheduling & Instructor -->
                        <Grid Grid.Row="2" ColumnDefinitions="*, *, *" Margin="0,0,0,20">
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Term*" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding AvailableTerms}" SelectedItem="{Binding NewTerm}" Background="{DynamicResource AppBackground}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                <TextBlock Text="Academic Year" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewAcademicYear}" Background="{DynamicResource AppBackground}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Professor Name" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewProfessorName}" PlaceholderText="e.g. Yuri Joseph Ortiz" Background="{DynamicResource AppBackground}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: Policy & Actions -->
                        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" VerticalAlignment="Bottom">
                            <StackPanel Grid.Column="0" Margin="0,0,20,0" MaxWidth="400" HorizontalAlignment="Left">
                                <TextBlock Text="Grading Policy Template*" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding AvailableTemplates}" SelectedItem="{Binding SelectedTemplate}" Background="{DynamicResource AppBackground}" HorizontalAlignment="Stretch" PlaceholderText="Select a saved template...">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding TemplateName}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                                <Button Command="{Binding ToggleAddClassFormCommand}" Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"/>
                                <Button Command="{Binding SaveClassCommand}" Content="Save Class" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Padding="20,10" CornerRadius="6"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <ItemsControl Grid.Row="3" ItemsSource="{Binding ActiveClasses}" Margin="40,0,40,40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" 
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="20" 
                                    Margin="0,0,20,20" 
                                    Width="320"> <!-- Increased Width for better readability -->
                                <Grid RowDefinitions="Auto, *, Auto, Auto">
                                    
                                    <!-- Header: Term Badge & Actions -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                                        <!-- Styled Term Badge -->
                                        <Border Grid.Column="0" Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Term}" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                            <Button Command="{Binding #RootControl.((vm:MyClassesViewModel)DataContext).EditClassCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="5" ToolTip.Tip="Edit Class">
                                                <TextBlock Classes="Icon" Text="{DynamicResource IconEdit}" Foreground="{DynamicResource TextMutedBrush}" FontSize="18"/>
                                            </Button>
                                            <Button Command="{Binding #RootControl.((vm:MyClassesViewModel)DataContext).DeleteClassCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="5" ToolTip.Tip="Delete Class">
                                                <TextBlock Classes="Icon" Text="{DynamicResource IconDelete}" Foreground="#EF4444" FontSize="18"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Body: Title & Program Info -->
                                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                                        <TextBlock Text="{Binding SubjectName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" LineHeight="24" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding ProgramSectionDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}"/>
                                            <TextBlock Text="•" Foreground="{DynamicResource BorderBrush}" FontSize="13"/>
                                            <TextBlock Text="{Binding AcademicYear}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Footer: Grading Policy Pill -->
                                    <Border Grid.Row="2" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,20">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <TextBlock Grid.Column="0" Text="Policy:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TemplateName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Primary Action -->
                                    <Button Grid.Row="3" 
                                        Command="{Binding #RootControl.((vm:MyClassesViewModel)DataContext).OpenClassCommand}" 
                                        CommandParameter="{Binding}" 
                                        Content="Open Gradebook →" 
                                        Background="{DynamicResource PrimaryBrush}" 
                                        Foreground="White" 
                                        FontWeight="Bold" 
                                        CornerRadius="8"
                                        Padding="0,12"
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ========================================== -->
        <!-- FLOATING OVERLAYS (Z-Index guarantees top) -->
        <!-- ========================================== -->

        <!-- 1. DELETE CONFIRMATION MODAL -->
        <Border IsVisible="{Binding IsDeleteModalOpen}" Background="#B3000000" ZIndex="100">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #40000000">
                <StackPanel>
                    <TextBlock Text="Delete Class?" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding DeleteConfirmationMessage}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,30"/>
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <Button Grid.Column="1" Command="{Binding CancelDeleteCommand}" Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" FontWeight="Bold" Padding="20,10" Margin="0,0,15,0"/>
                        <Button Grid.Column="2" Command="{Binding ConfirmDeleteCommand}" Content="Delete Class" Background="#EF4444" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="20,10"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 2. PROCESSING SPINNER OVERLAY -->
        <Border IsVisible="{Binding IsProcessing}" Background="#B3000000" ZIndex="999">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 10 30 0 #40000000">
                <StackPanel Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="150" Height="6" CornerRadius="3" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource AppBackground}"/>
                    <TextBlock Text="Processing Action..." FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>