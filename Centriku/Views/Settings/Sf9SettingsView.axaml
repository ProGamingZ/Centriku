<UserControl xmlns="https://github.com/avaloniaui"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:vm="using:Centriku.ViewModels.Settings"
   x:Class="Centriku.Views.Settings.Sf9SettingsView"
   x:DataType="vm:Sf9SettingsViewModel">

   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="20,20,40,20">
         
         <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="SF9 Report Card Configuration" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
            <TextBlock Text="Set your official school headers, signatories, and DepEd formatting rules." Foreground="{DynamicResource TextMutedBrush}"/>
         </StackPanel>

         <WrapPanel Grid.Row="1" Orientation="Horizontal">
               
            <Border Margin="0,0,20,20" Width="380" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
               <StackPanel Spacing="15">
                  <TextBlock Text="🏫 School Identity" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextMainBrush}"/>
                  <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,-5,0,5"/>

                  <StackPanel Spacing="5">
                        <TextBlock Text="School Name" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Text="{Binding SchoolName}" PlaceholderText="e.g. Bacolod National High School" Background="{DynamicResource AppBackground}"/>
                  </StackPanel>

                  <Grid ColumnDefinitions="1*, 1*" RowDefinitions="Auto">
                        <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,10,0">
                           <TextBlock Text="School ID" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                           <TextBox Text="{Binding SchoolId}" PlaceholderText="e.g. 123456" Background="{DynamicResource AppBackground}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5" Margin="10,0,0,0">
                           <TextBlock Text="Region" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                           <TextBox Text="{Binding Region}" PlaceholderText="e.g. Region VI" Background="{DynamicResource AppBackground}"/>
                        </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="1*, 1*" RowDefinitions="Auto">
                        <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,10,0">
                           <TextBlock Text="Division" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                           <TextBox Text="{Binding Division}" PlaceholderText="e.g. Bacolod City" Background="{DynamicResource AppBackground}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5" Margin="10,0,0,0">
                           <TextBlock Text="District" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                           <TextBox Text="{Binding District}" PlaceholderText="District" Background="{DynamicResource AppBackground}"/>
                        </StackPanel>
                  </Grid>
               </StackPanel>
            </Border>

            <Border Margin="0,0,20,20" Width="380" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
               <StackPanel Spacing="15">
                  <TextBlock Text="✍️ Official Signatories" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextMainBrush}"/>
                  <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,-5,0,5"/>

                  <StackPanel Spacing="5">
                        <TextBlock Text="Principal's Name" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Text="{Binding PrincipalName}" PlaceholderText="e.g. Dr. Maria Clara, Ed.D." Background="{DynamicResource AppBackground}"/>
                  </StackPanel>

                  <StackPanel Spacing="5">
                        <TextBlock Text="Principal's Title" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Text="{Binding PrincipalTitle}" PlaceholderText="e.g. Principal IV" Background="{DynamicResource AppBackground}"/>
                  </StackPanel>
                  
                  <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,5"/>

                  <StackPanel Spacing="5">
                        <TextBlock Text="Default Teacher / Adviser Name" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Text="{Binding DefaultTeacherName}" PlaceholderText="e.g. Juan Dela Cruz" Background="{DynamicResource AppBackground}"/>
                        <TextBlock Text="This prints on the bottom left signature line." FontSize="11" Foreground="{DynamicResource PrimaryBrush}" FontStyle="Italic"/>
                  </StackPanel>
               </StackPanel>
            </Border>

            <Border Margin="0,0,20,20" Width="380" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                  <StackPanel Spacing="15">
                     <TextBlock Text="⚙️ Generation Preferences" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextMainBrush}"/>
                     <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,-5,0,5"/>

                     <Grid ColumnDefinitions="*, Auto">
                           <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,20,0">
                              <TextBlock Text="Default Save Location" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding Sf9DefaultExportPath, TargetNullValue='No Default Folder Selected (Downloads will prompt)'}" 
                                          FontStyle="Italic" Foreground="{DynamicResource PrimaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="11"/>
                           </StackPanel>
                           <Button Grid.Column="1" Content="Browse..." Click="OnBrowseFolderClicked" Background="{DynamicResource SurfaceVariantBrush}" VerticalAlignment="Center"/>
                     </Grid>
                     
                     <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,5,0,0">
                           <ToggleSwitch IsChecked="{Binding Sf9AutoOpenPdf}" OnContent="Yes" OffContent="No"/>
                           <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="Auto-Open PDF" FontWeight="SemiBold"/>
                              <TextBlock Text="Open the file instantly after generation." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                           </StackPanel>
                     </StackPanel>

                     <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,5"/>

                     <Grid ColumnDefinitions="1*, 1*" RowDefinitions="Auto">
                           <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,10,0">
                              <TextBlock Text="Passing Grade" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                              <NumericUpDown Value="{Binding PassingGradeThreshold}" Minimum="50" Maximum="100" Background="{DynamicResource AppBackground}"/>
                           </StackPanel>
                           <StackPanel Grid.Column="1" Spacing="5" Margin="10,0,0,0">
                              <TextBlock Text="Blank Grades" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                              <ComboBox ItemsSource="{Binding BlankOutputs}" SelectedItem="{Binding BlankGradeOutput}" HorizontalAlignment="Stretch" Background="{DynamicResource AppBackground}"/>
                           </StackPanel>
                     </Grid>
                  </StackPanel>
               </Border>

            <Border Margin="0,0,20,20" Width="450" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                  <StackPanel Spacing="15">
                     <TextBlock Text="📋 Custom Grading Legend" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextMainBrush}"/>
                     <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,-5,0,5"/>
                     <TextBlock Text="Modify the scale printed at the bottom of the SF9." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,-10,0,5"/>

                     <Grid ColumnDefinitions="2*, 1*, 1*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Descriptor" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Scale" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Remark" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>

                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding LegDesc1}" Margin="0,5,5,0" Background="{DynamicResource AppBackground}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LegScale1}" Margin="0,5,5,0" Background="{DynamicResource AppBackground}"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding LegRem1}" Margin="0,5,0,0" Background="{DynamicResource AppBackground}"/>

                        <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding LegDesc2}" Margin="0,5,5,0" Background="{DynamicResource AppBackground}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LegScale2}" Margin="0,5,5,0" Background="{DynamicResource AppBackground}"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding LegRem2}" Margin="0,5,0,0" Background="{DynamicResource AppBackground}"/>

                        <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding LegDesc3}" Margin="0,5,5,0" Background="{DynamicResource AppBackground}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LegScale3}" Margin="0,5,5,0" Background="{DynamicResource AppBackground}"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding LegRem3}" Margin="0,5,0,0" Background="{DynamicResource AppBackground}"/>

                        <TextBox Grid.Row="4" Grid.Column="0" Text="{Binding LegDesc4}" Margin="0,5,5,0" Background="{DynamicResource AppBackground}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LegScale4}" Margin="0,5,5,0" Background="{DynamicResource AppBackground}"/>
                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding LegRem4}" Margin="0,5,0,0" Background="{DynamicResource AppBackground}"/>

                        <TextBox Grid.Row="5" Grid.Column="0" Text="{Binding LegDesc5}" Margin="0,5,5,0" Background="{DynamicResource AppBackground}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LegScale5}" Margin="0,5,5,0" Background="{DynamicResource AppBackground}"/>
                        <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding LegRem5}" Margin="0,5,0,0" Background="{DynamicResource AppBackground}"/>
                     </Grid>
                  </StackPanel>
               </Border>

         </WrapPanel>

         <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15" Margin="0,0,20,20">
            <Button Command="{Binding ResetDefaultsCommand}" Content="Reset to Defaults" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"/>
            <Button Command="{Binding SaveSettingsCommand}" Content="💾 Save SF9 Settings" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Padding="20,10" CornerRadius="8"/>
         </StackPanel>

         <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2" CornerRadius="12" Padding="20" Margin="0,0,20,20" VerticalAlignment="Top">
            <StackPanel Spacing="10">
               <TextBlock Text="📄 Report Card Previews" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
               <TextBlock Text="See how your changes will appear on the final PDF." Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,-5,0,10"/>
               
               <TabControl>
                  
                  <TabItem Header="Header &amp; Signatures" FontSize="14" FontWeight="SemiBold">
                     <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="30" Margin="0,10,0,0" Background="{DynamicResource AppBackground}">
                        <StackPanel>
                           <TextBlock Text="Republic of the Philippines" HorizontalAlignment="Center" FontSize="12"/>
                           <TextBlock Text="Department of Education" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                           <TextBlock Text="{Binding Region}" HorizontalAlignment="Center" FontSize="12" IsVisible="{Binding Region, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                           <TextBlock Text="{Binding Division, StringFormat='Division of {0}'}" HorizontalAlignment="Center" FontSize="12" IsVisible="{Binding Division, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                           <TextBlock Text="{Binding SchoolName, TargetNullValue='Learner Progress Report Card (SF9)'}" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>
                           
                           <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0,5,0,0">
                              <TextBlock Text="{Binding SchoolId, StringFormat='School ID: {0}'}" FontSize="12"/>
                              <TextBlock Text="{Binding District, StringFormat='District: {0}'}" FontSize="12"/>
                           </StackPanel>

                           <Line StartPoint="0,0" EndPoint="10,0" Stretch="Fill" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="4,4" Margin="0,30,0,20"/>
                           <TextBlock Text="CERTIFICATE OF TRANSFER" FontSize="12" FontWeight="Bold"/>
                           <Grid ColumnDefinitions="1*, 1*" Margin="0,30,0,0">
                              <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                 <TextBlock Text="{Binding DefaultTeacherName, TargetNullValue='________________________'}" FontWeight="Bold" TextDecorations="Underline" HorizontalAlignment="Center"/>
                                 <TextBlock Text="Teacher / Adviser" FontSize="12" HorizontalAlignment="Center"/>
                              </StackPanel>
                              <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                 <TextBlock Text="{Binding PrincipalName, TargetNullValue='________________________'}" FontWeight="Bold" TextDecorations="Underline" HorizontalAlignment="Center"/>
                                 <TextBlock Text="{Binding PrincipalTitle}" FontSize="12" HorizontalAlignment="Center"/>
                              </StackPanel>
                           </Grid>
                        </StackPanel>
                     </Border>
                  </TabItem>

                  <TabItem Header="Grades &amp; Remarks" FontSize="14" FontWeight="SemiBold">
                     <DataGrid ItemsSource="{Binding PreviewGrades}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8" Height="150" Margin="0,10,0,0">
                        <DataGrid.Columns>
                           <DataGridTextColumn Header="Learning Areas" Binding="{Binding Subject}" Width="*"/>
                           <DataGridTextColumn Header="1" Binding="{Binding Q1}" Width="60"/>
                           <DataGridTextColumn Header="2" Binding="{Binding Q2}" Width="60"/>
                           <DataGridTextColumn Header="3" Binding="{Binding Q3}" Width="60"/>
                           <DataGridTextColumn Header="4" Binding="{Binding Q4}" Width="60"/>
                           <DataGridTextColumn Header="Final Grade" Binding="{Binding Final}" Width="90"/>
                           <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="90"/>
                        </DataGrid.Columns>
                     </DataGrid>
                  </TabItem>

                  <TabItem Header="Grading Legend" FontSize="14" FontWeight="SemiBold">
                     <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" Padding="15" Background="{DynamicResource AppBackground}">
                        <Grid ColumnDefinitions="2*, 1*, 1*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                           <TextBlock Grid.Row="0" Grid.Column="0" Text="Descriptors" FontWeight="Bold" Margin="0,0,0,10"/>
                           <TextBlock Grid.Row="0" Grid.Column="1" Text="Grading Scale" FontWeight="Bold" Margin="0,0,0,10"/>
                           <TextBlock Grid.Row="0" Grid.Column="2" Text="Remarks" FontWeight="Bold" Margin="0,0,0,10"/>

                           <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LegDesc1}" Margin="0,0,0,5"/>
                           <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LegScale1}"/>
                           <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LegRem1}"/>

                           <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LegDesc2}" Margin="0,0,0,5"/>
                           <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LegScale2}"/>
                           <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LegRem2}"/>

                           <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding LegDesc3}" Margin="0,0,0,5"/>
                           <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LegScale3}"/>
                           <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding LegRem3}"/>

                           <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding LegDesc4}" Margin="0,0,0,5"/>
                           <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LegScale4}"/>
                           <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding LegRem4}"/>

                           <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding LegDesc5}"/>
                           <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LegScale5}"/>
                           <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding LegRem5}"/>
                        </Grid>
                     </Border>
                  </TabItem>

               </TabControl>
            </StackPanel>
         </Border>

      </Grid>
   </ScrollViewer>
</UserControl>