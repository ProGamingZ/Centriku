<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Centriku.ViewModels.Settings"
             x:Class="Centriku.Views.Settings.SystemSettingsView"
             x:DataType="vm:SystemSettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,25,0" Spacing="20">
            
            <!-- Header & Mode Toggle -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Manage your database backups and system health." FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Developer Diagnostics" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <ToggleSwitch IsChecked="{Binding IsDeveloperMode}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource BorderBrush}"/>

            <!-- ========================================== -->
            <!-- STANDARD MODE (Non-Technical Teachers)     -->
            <!-- ========================================== -->
            <StackPanel IsVisible="{Binding !IsDeveloperMode}" Spacing="20">
                
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="25">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Text="Database Health" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="Centriku runs securely offline on your computer. Regular backups and maintenance keep your gradebooks fast and accurate." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,20,0"/>
                            
                            <WrapPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <StackPanel Margin="0,0,30,10">
                                    <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding DbStatus}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,30,10">
                                    <TextBlock Text="LAST BACKUP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding LastBackupDate}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,30,10">
                                    <TextBlock Text="FILE SIZE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding DbSizeMb}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="SCHEMA VERSION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SchemaVersionDisplay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Text="{Binding StandardFeedbackMessage}" IsVisible="{Binding StandardFeedbackMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Friendly 1-Click Maintenance Button -->
                        <Button Grid.Column="1" Command="{Binding OptimizeSystemCommand}" Background="{DynamicResource SurfaceVariantBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,12" VerticalAlignment="Center">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Optimize &amp; Clean" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Fix counts &amp; compact storage" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*, *" Margin="0,5,0,0">
                    <!-- Backup Button -->
                    <Button Grid.Column="0" Click="OnBackupClicked" Background="{DynamicResource PrimaryBrush}" Foreground="White" CornerRadius="8" Padding="20" HorizontalAlignment="Stretch" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                            <TextBlock Classes="Icon" Text="{DynamicResource IconSave}" FontSize="24"/>
                            <StackPanel>
                                <TextBlock Text="Create Backup" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Save a secure copy of your database" FontSize="11" Opacity="0.8"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    
                    <!-- Restore Button -->
                    <Button Grid.Column="1" Click="OnRestoreClicked" Background="{DynamicResource SurfaceVariantBrush}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Stretch" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                            <TextBlock Classes="Icon" Text="{DynamicResource IconRestore}" FontSize="24" Foreground="{DynamicResource TextMutedBrush}"/>
                            <StackPanel>
                                <TextBlock Text="Restore from Backup" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Overwrite current system with an older file" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- ========================================== -->
            <!-- DEVELOPER MODE (Technical Console)         -->
            <!-- ========================================== -->
            <StackPanel IsVisible="{Binding IsDeveloperMode}" Spacing="15">
                
                <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="SYSTEM DIAGNOSTICS &amp; RELATIONAL TELEMETRY" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SchemaVersionDisplay}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SuccessBrush}" FontFamily="Consolas, Courier New, monospace"/>
                        </Grid>
                        
                        <TextBlock Text="{Binding TelemetrySummary}" Foreground="#E4E4E7" FontSize="12" FontFamily="Consolas, Courier New, monospace" Margin="0,4,0,0"/>

                        <Grid ColumnDefinitions="Auto, *" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" Text="DB Path: " FontWeight="Bold" Foreground="#A1A1AA" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding AbsoluteFilePath}" Foreground="#60A5FA" FontSize="12" FontFamily="Consolas, Courier New, monospace" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Developer Command Toolbar -->
                <WrapPanel Orientation="Horizontal">
                    <Button Command="{Binding RunIntegrityCheckCommand}" Content="1. PRAGMA integrity_check" Background="#374151" Foreground="White" FontFamily="Consolas, Courier New, monospace" FontSize="12" Padding="12,8" CornerRadius="4" Margin="0,0,10,10"/>
                    <Button Command="{Binding ScanOrphansCommand}" Content="2. Scan Ghost Records" Background="#374151" Foreground="#FBBF24" FontFamily="Consolas, Courier New, monospace" FontSize="12" Padding="12,8" CornerRadius="4" Margin="0,0,10,10"/>
                    <Button Command="{Binding PurgeOrphansCommand}" Content="3. Purge Ghost Records" Background="#374151" Foreground="#F87171" FontFamily="Consolas, Courier New, monospace" FontSize="12" Padding="12,8" CornerRadius="4" Margin="0,0,10,10"/>
                    <Button Command="{Binding RunVacuumCommand}" Content="4. Execute VACUUM" Background="#374151" Foreground="#34D399" FontFamily="Consolas, Courier New, monospace" FontSize="12" Padding="12,8" CornerRadius="4" Margin="0,0,10,10"/>
                    <Button Command="{Binding OpenDataFolderCommand}" Content="5. Open Data Folder" Background="#374151" Foreground="#60A5FA" FontFamily="Consolas, Courier New, monospace" FontSize="12" Padding="12,8" CornerRadius="4" Margin="0,0,10,10"/>
                </WrapPanel>

                <!-- Console Output Box -->
                <Border Background="#000000" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="15" MinHeight="180">
                    <TextBlock Text="{Binding DiagnosticOutput}" Foreground="{DynamicResource SuccessBrush}" FontFamily="Consolas, Courier New, monospace" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>