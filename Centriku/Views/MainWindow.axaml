<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Centriku.ViewModels"
        x:Class="Centriku.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Centriku"
        MinWidth="{Binding MinWidth}" 
        MinHeight="{Binding MinHeight}"
        WindowState="{Binding CurrentWindowState}"
        Background="{DynamicResource AppBackground}" 
        Foreground="{DynamicResource TextMainBrush}">

    <Window.Styles>
        <!-- The Base Style for all Sidebar Navigation Buttons -->
        <Style Selector="Button.NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        
        <!-- Hover state overriding Avalonia default -->
        <Style Selector="Button.NavButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <!-- Active/Glowing State overriding Avalonia default -->
        <Style Selector="Button.NavButton.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.NavButton.active TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <SplitView IsPaneOpen="{Binding IsSidebarOpen}"
               DisplayMode="CompactInline"
               CompactPaneLength="70"
               OpenPaneLength="180"
               Background="{DynamicResource AppBackground}"
               PaneBackground="{DynamicResource SurfaceBrush}">
        
        <SplitView.Pane>
            <Grid RowDefinitions="Auto, *">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="25,20,0,30">
                    <TextBlock Text="C" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="Centriku" FontSize="20" FontWeight="Bold" Margin="15,2,0,0" IsVisible="{Binding IsSidebarOpen}"/>
                </StackPanel>

                <!-- NEW: Cleaned up buttons that bind dynamically to the ViewModel trackers -->
                <StackPanel Grid.Row="1" Spacing="10" Margin="10,0">
                    
                    <Button Classes="NavButton" Classes.active="{Binding IsDashboardActive}" Command="{Binding NavigateToDashboardCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <TextBlock Classes="Icon" Text="{DynamicResource IconDashboard}"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="NavButton" Classes.active="{Binding IsMyClassesActive}" Command="{Binding NavigateToMyClassesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <TextBlock Classes="Icon" Text="{DynamicResource IconClasses}"/>
                            <TextBlock Text="My Classes" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="NavButton" Classes.active="{Binding IsPoliciesActive}" Command="{Binding NavigateToPoliciesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <TextBlock Classes="Icon" Text="{DynamicResource IconPolicies}"/>
                            <TextBlock Text="Policies" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="NavButton" Classes.active="{Binding IsDirectoryActive}" Command="{Binding NavigateToDirectoryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <TextBlock Classes="Icon" Text="{DynamicResource IconDirectory}"/>
                            <TextBlock Text="Directory" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Classes="NavButton" Classes.active="{Binding IsSettingsActive}" Command="{Binding NavigateToSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <TextBlock Classes="Icon" Text="{DynamicResource IconSettings}"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </SplitView.Pane>

        <SplitView.Content>
            <Grid RowDefinitions="70, *">
                <Border Grid.Row="0" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="20,0">
                        
                        <Button Grid.Column="0" Command="{Binding ToggleSidebarCommand}" 
                                Background="Transparent" FontSize="20" Foreground="{DynamicResource TextMainBrush}"
                                Content="≡" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Command="{Binding ToggleThemeCommand}" 
                                    Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" 
                                    CornerRadius="6" Padding="12,8" ToolTip.Tip="Switch Color Mode">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Classes="Icon" Text="{DynamicResource IconTheme}" FontSize="18"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
            </Grid>
        </SplitView.Content>

    </SplitView>
</Window>