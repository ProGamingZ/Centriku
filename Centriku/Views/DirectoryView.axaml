<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Centriku.ViewModels"
             xmlns:dir="using:Centriku.Views.Directory"
             x:Class="Centriku.Views.DirectoryView"
             x:DataType="vm:DirectoryViewModel"
             x:Name="DirectoryRoot">

    <Grid>
        <TabControl Margin="10" SelectedIndex="{Binding SelectedTabIndex}">
            
            <TabItem Header="Master Roster" FontSize="16" FontWeight="SemiBold">
                <dir:MasterRosterTab />
            </TabItem>

            <TabItem Header="Bulk Import" FontSize="16" FontWeight="SemiBold">
                <dir:BulkImportTab />
            </TabItem>

            <TabItem Header="Archives" FontSize="16" FontWeight="SemiBold">
                <dir:ArchivesTab />
            </TabItem>

        </TabControl>

        <dir:StudentProfileOverlay />

        <!-- Shared Confirmation Modal for Bulk Archive, Restore, and Delete -->
        <Border IsVisible="{Binding IsConfirmModalOpen}" Background="#B3000000" ZIndex="150">
            <Border DataContext="{Binding ConfirmModal}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #40000000">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,30"/>
                    
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <Button Grid.Column="1" Command="{Binding CancelCommand}" Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" FontWeight="Bold" Padding="20,10" Margin="0,0,15,0"/>
                        <Button Grid.Column="2" Command="{Binding ConfirmCommand}" 
                                Content="{Binding #DirectoryRoot.((vm:DirectoryViewModel)DataContext).ConfirmModalButtonText}" 
                                Background="{Binding #DirectoryRoot.((vm:DirectoryViewModel)DataContext).ConfirmModalButtonColor}" 
                                Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="20,10"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Floating Toast Notification Banner -->
        <Border IsVisible="{Binding IsToastVisible}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="4,1,1,1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,30,30"
                MinWidth="300"
                MaxWidth="420"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                ZIndex="200"
                BoxShadow="0 10 25 0 #66000000">
            <Grid ColumnDefinitions="Auto, *">
                <TextBlock Grid.Column="0"
                           Classes="Icon"
                           Text="{DynamicResource IconEarlyWarning}"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ToastMessage}"
                           Foreground="{DynamicResource TextMainBrush}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>

</UserControl>