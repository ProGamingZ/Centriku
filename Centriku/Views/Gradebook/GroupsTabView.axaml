<UserControl xmlns="https://github.com/avaloniaui"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:vm="using:Centriku.ViewModels"
   x:Class="Centriku.Views.Gradebook.GroupsTabView"
   x:DataType="vm:GradebookViewModel"
   x:Name="GroupsTabRoot">

   <Grid RowDefinitions="Auto, *">
      
      <!-- Top Action Bar -->
      <Grid Grid.Row="0" Margin="24,20,24,15" ColumnDefinitions="Auto, *, Auto">
         <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
            <StackPanel>
               <TextBlock Text="Select Group Assessment" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
               <ComboBox ItemsSource="{Binding AvailableGroupAssessments}" SelectedItem="{Binding SelectedGroupAssessment}" Width="250" Background="{DynamicResource AppBackground}">
                  <ComboBox.ItemTemplate>
                     <DataTemplate>
                        <TextBlock Text="{Binding Title}"/>
                     </DataTemplate>
                  </ComboBox.ItemTemplate>
               </ComboBox>
            </StackPanel>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Bottom" IsVisible="{Binding SelectedGroupAssessment, Converter={x:Static ObjectConverters.IsNotNull}}">
               <TextBlock Foreground="{DynamicResource TextMainBrush}" FontSize="12" FontWeight="SemiBold">
                  <Run Text="Max Score: " Foreground="{DynamicResource TextMutedBrush}" FontWeight="Normal"/>
                  <Run Text="{Binding SelectedGroupAssessment.MaxScore}" Foreground="{DynamicResource PrimaryBrush}"/>
                  <Run Text="   |   " Foreground="{DynamicResource BorderBrush}" FontWeight="Normal"/>
                  <Run Text="Weight: " Foreground="{DynamicResource TextMutedBrush}" FontWeight="Normal"/>
                  <Run Text="{Binding SelectedGroupAssessment.GroupWeight}" />
                  <Run Text="% Group / " Foreground="{DynamicResource TextMutedBrush}" FontWeight="Normal"/>
                  <Run Text="{Binding SelectedGroupAssessment.IndividualWeight}" />
                  <Run Text="% Individual" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Normal"/>
               </TextBlock>
            </Border>
         </StackPanel>

         <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
            <Button Command="{Binding OpenCopyGroupsModalCommand}" Content="Copy Groups" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" FontWeight="Bold" CornerRadius="8" Padding="16,8"/>
            <Button Command="{Binding OpenCreateGroupModalCommand}" Content="+ Create Group" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="16,8"/>
         </StackPanel>
      </Grid>

      <!-- Main Body -->
      <Grid Grid.Row="1" Margin="24,0,24,24" ColumnDefinitions="*, 300">

         <!-- Groups Cards List -->
         <ScrollViewer Grid.Column="0" Margin="0,0,15,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CurrentAssessmentGroups}">
               <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                     <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
               </ItemsControl.ItemsPanel>
               <ItemsControl.ItemTemplate>
                  <DataTemplate>
                     <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,15,15" Width="380">
                        <StackPanel Spacing="12">
                           
                           <!-- Card Header -->
                           <Grid ColumnDefinitions="*, Auto, Auto">
                              <TextBlock Grid.Column="0" Text="{Binding GroupName}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                              
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,0,10,0" VerticalAlignment="Center">
                                 <TextBlock Text="Group Score:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                 <TextBox Text="{Binding GroupScoreDisplay}" Width="65" Background="{DynamicResource AppBackground}" HorizontalContentAlignment="Center"/>
                              </StackPanel>

                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                 <!-- Edit Button -->
                                 <Button Command="{Binding #GroupsTabRoot.((vm:GradebookViewModel)DataContext).OpenEditGroupModalCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="4" ToolTip.Tip="Edit Group">
                                    <TextBlock Text="✏️" FontSize="12"/>
                                 </Button>
                                 <!-- Delete Button -->
                                 <Button Command="{Binding #GroupsTabRoot.((vm:GradebookViewModel)DataContext).PromptDeleteGroupCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="4" ToolTip.Tip="Delete Group">
                                    <TextBlock Text="❌" Foreground="#EF4444" FontSize="12"/>
                                 </Button>
                              </StackPanel>
                           </Grid>

                           <Border Height="1" Background="{DynamicResource BorderBrush}"/>

                           <!-- Member Rows -->
                           <ItemsControl ItemsSource="{Binding Members}">
                              <ItemsControl.ItemTemplate>
                                 <DataTemplate>
                                    <Grid ColumnDefinitions="*, 80, 60" Margin="0,4">
                                       <TextBlock Grid.Column="0" Text="{Binding FullName}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                       
                                       <!-- Individual Score Input -->
                                       <TextBox Grid.Column="1" Text="{Binding IndividualScoreDisplay}" Margin="4,0" Background="{DynamicResource AppBackground}" HorizontalContentAlignment="Center"/>
                                       <!-- Computed Combined Grade -->
                                       <Border Grid.Column="2" Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                          <TextBlock Text="{Binding TotalComputedGrade}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}"/>
                                       </Border>
                                    </Grid>
                                 </DataTemplate>
                              </ItemsControl.ItemTemplate>
                           </ItemsControl>

                        </StackPanel>
                     </Border>
                  </DataTemplate>
               </ItemsControl.ItemTemplate>
            </ItemsControl>
         </ScrollViewer>

         <!-- Unassigned / Solo Students Drawer -->
         <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15">
            <Grid RowDefinitions="Auto, *">
               <StackPanel Grid.Row="0" Margin="0,0,0,10">
                  <TextBlock Text="Unassigned Students" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextMainBrush}"/>
                  <TextBlock Text="Click 'Solo' to create a 1-person solo group." FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
               </StackPanel>

               <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding UnassignedStudents}">
                     <ItemsControl.ItemTemplate>
                        <DataTemplate>
                           <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                              <TextBlock Grid.Column="0" Text="{Binding FullName}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMainBrush}"/>
                              <Button Grid.Column="1" Command="{Binding #GroupsTabRoot.((vm:GradebookViewModel)DataContext).AddSoloGroupCommand}" CommandParameter="{Binding}" Background="Transparent" Margin="0,0,11,0" ToolTip.Tip="Set as 1-person Solo Group">
                                 <TextBlock Text=" Solo" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                              </Button>
                           </Grid>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>
               </ScrollViewer>
            </Grid>
         </Border>

      </Grid>

      <!-- Create Group Modal Dialog -->
      <Border IsVisible="{Binding IsCreatingGroupModalOpen}" Background="#B3000000" ZIndex="100" Grid.RowSpan="2">
         <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Width="440" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid RowDefinitions="Auto, Auto, *, Auto">
               <TextBlock Grid.Row="0" Text="Create New Group" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,12"/>
               
               <StackPanel Grid.Row="1" Margin="0,0,0,12">
                  <TextBlock Text="Group Name" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                  <TextBox Text="{Binding NewGroupNameInput}" Background="{DynamicResource AppBackground}"/>
               </StackPanel>

               <TextBlock Grid.Row="1" Text="Select Members:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,65,0,0"/>

               <!-- Student Selection Checkboxes -->
               <ScrollViewer Grid.Row="2" Margin="0,10,0,16" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding CandidateMembers}">
                     <ItemsControl.ItemTemplate>
                        <DataTemplate>
                           <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                              <TextBlock Text="{Binding FullName}" FontSize="12"/>
                           </CheckBox>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>
               </ScrollViewer>

               <Grid Grid.Row="3" ColumnDefinitions="*, Auto, Auto">
                  <Button Grid.Column="1" Command="{Binding CancelCreateGroupCommand}" Content="Cancel" Background="Transparent" Margin="0,0,10,0"/>
                  <Button Grid.Column="2" Command="{Binding ConfirmCreateGroupCommand}" Content="Create" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold"/>
               </Grid>
            </Grid>
         </Border>
      </Border>
      <Border IsVisible="{Binding IsDeleteGroupModalOpen}" Background="#B3000000" ZIndex="100" Grid.RowSpan="2">
         <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="30" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
               <TextBlock Text="Delete Group?" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,12"/>
               <TextBlock Text="{Binding DeleteGroupModalMessage}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,24"/>
               <Grid ColumnDefinitions="*, Auto, Auto">
                  <Button Grid.Column="1" Command="{Binding CancelDeleteGroupCommand}" Content="Cancel" Background="Transparent" Margin="0,0,10,0"/>
                  <Button Grid.Column="2" Command="{Binding ConfirmDeleteGroupCommand}" Content="Delete Group" Background="#EF4444" Foreground="White" FontWeight="Bold"/>
               </Grid>
            </StackPanel>
         </Border>
      </Border>
      <Border IsVisible="{Binding IsEditingGroupModalOpen}" Background="#B3000000" ZIndex="100" Grid.RowSpan="2">
         <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Width="440" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid RowDefinitions="Auto, Auto, *, Auto">
               <TextBlock Grid.Row="0" Text="Edit Group" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,12"/>
               
               <StackPanel Grid.Row="1" Margin="0,0,0,12">
                  <TextBlock Text="Group Name" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                  <TextBox Text="{Binding EditGroupNameInput}" Background="{DynamicResource AppBackground}"/>
               </StackPanel>

               <TextBlock Grid.Row="1" Text="Select Members:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,65,0,0"/>

               <!-- Student Selection Checkboxes -->
               <ScrollViewer Grid.Row="2" Margin="0,10,0,16" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding EditCandidateMembers}">
                     <ItemsControl.ItemTemplate>
                        <DataTemplate>
                           <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                              <TextBlock Text="{Binding FullName}" FontSize="12" Foreground="{DynamicResource TextMainBrush}"/>
                           </CheckBox>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>
               </ScrollViewer>

               <Grid Grid.Row="3" ColumnDefinitions="*, Auto, Auto">
                  <Button Grid.Column="1" Command="{Binding CancelEditGroupCommand}" Content="Cancel" Background="Transparent" Margin="0,0,10,0"/>
                  <Button Grid.Column="2" Command="{Binding ConfirmEditGroupCommand}" Content="Save Changes" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold"/>
               </Grid>
            </Grid>
         </Border>
      </Border>
      <Border IsVisible="{Binding IsCopyGroupsModalOpen}" Background="#B3000000" ZIndex="100" Grid.RowSpan="2">
         <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
               <TextBlock Text="Copy Groups" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,12"/>
               
               <TextBlock Text="Select a previous assessment. All of its groups and members will be cloned into this assessment (grades will be reset to 0)." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

               <TextBlock Text="Copy From:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
               <ComboBox ItemsSource="{Binding CopyFromAssessments}" SelectedItem="{Binding SelectedCopyFromAssessment}" HorizontalAlignment="Stretch" Background="{DynamicResource AppBackground}" Margin="0,0,0,25">
                  <ComboBox.ItemTemplate>
                     <DataTemplate>
                        <TextBlock Text="{Binding Title}"/>
                     </DataTemplate>
                  </ComboBox.ItemTemplate>
               </ComboBox>

               <Grid ColumnDefinitions="*, Auto, Auto">
                  <Button Grid.Column="1" Command="{Binding CancelCopyGroupsCommand}" Content="Cancel" Background="Transparent" Margin="0,0,10,0"/>
                  <Button Grid.Column="2" Command="{Binding ConfirmCopyGroupsCommand}" Content="Copy Now" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold"/>
               </Grid>
            </StackPanel>
         </Border>
      </Border>
   </Grid>
</UserControl>