<UserControl xmlns="https://github.com/avaloniaui"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:vm="using:Centriku.ViewModels"
   x:Class="Centriku.Views.Gradebook.GroupsTabView"
   x:DataType="vm:GradebookViewModel"
   x:Name="GroupsTabRoot">

   <Grid RowDefinitions="Auto, *">
      
      <!-- Top Action Bar -->
      <Grid Grid.Row="0" Margin="24,20,24,15" ColumnDefinitions="*, Auto">
         
         <!-- LEFT SIDE: Fluid WrapPanel for dropdown and info badge -->
         <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
            
            <StackPanel Margin="0,0,15,10">
               <TextBlock Text="Select Group Assessment" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
               <ComboBox ItemsSource="{Binding AvailableGroupAssessments}" SelectedItem="{Binding SelectedGroupAssessment}" Width="260" PlaceholderText="No group assessments found">
                  <ComboBox.ItemTemplate>
                     <DataTemplate>
                        <TextBlock Text="{Binding Title}"/>
                     </DataTemplate>
                  </ComboBox.ItemTemplate>
               </ComboBox>
            </StackPanel>

            <Border Margin="0,0,15,10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="15,9" VerticalAlignment="Bottom" IsVisible="{Binding SelectedGroupAssessment, Converter={x:Static ObjectConverters.IsNotNull}}">
               <TextBlock Foreground="{DynamicResource TextMainBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                  <Run Text="Max Score: " Foreground="{DynamicResource TextMutedBrush}" FontWeight="Normal"/>
                  <Run Text="{Binding SelectedGroupAssessment.MaxScore}" Foreground="{DynamicResource PrimaryBrush}"/>
                  <Run Text="   |   " Foreground="{DynamicResource BorderStrongBrush}" FontWeight="Normal"/>
                  <Run Text="Formula: " Foreground="{DynamicResource TextMutedBrush}" FontWeight="Normal"/>
                  <Run Text="Group Score + Individual Score" Foreground="{DynamicResource PrimaryBrush}" />
               </TextBlock>
            </Border>

         </WrapPanel>

         <!-- RIGHT SIDE: Action Buttons -->
         <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom" Margin="0,0,0,10">
            <Button Command="{Binding OpenCopyGroupsModalCommand}" Content="Copy Groups" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5" FontWeight="Bold" CornerRadius="8" Padding="16,9"/>
            <Button Command="{Binding OpenCreateGroupModalCommand}" Content="+ Create Group" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="16,9"/>
         </StackPanel>

      </Grid>

      <!-- Main Body -->
      <Grid Grid.Row="1" Margin="24,0,24,24" ColumnDefinitions="3*, 1*">

         <!-- Groups Cards List & Empty State -->
         <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
            <Panel>
               <!-- Empty State Card when no groups exist -->
               <Border IsVisible="{Binding HasNoGroups}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                  <StackPanel Spacing="10" HorizontalAlignment="Center">
                     <TextBlock Classes="Icon" Text="{DynamicResource IconEmptyState}" FontSize="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                     <TextBlock Text="No Groups Created Yet" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Center"/>
                     <TextBlock Text="Select a Group/Pair assessment above and click '+ Create Group' or 'Solo' on the right to assign students." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" HorizontalAlignment="Center"/>
                  </StackPanel>
               </Border>

               <ItemsControl ItemsSource="{Binding CurrentAssessmentGroups}" IsVisible="{Binding !HasNoGroups}">
                  <ItemsControl.ItemsPanel>
                     <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                     </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                     <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,15,15" Width="385">
                           <StackPanel Spacing="12">
                              
                              <!-- Card Header (Group Name & Actions) -->
                              <Grid ColumnDefinitions="*, Auto, Auto">
                                 <TextBlock Grid.Column="0" Text="{Binding GroupName}" ToolTip.Tip="{Binding GroupName}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextMainBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                 
                                 <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="Group Score:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding GroupScoreDisplay}" Width="68" HorizontalContentAlignment="Center"/>
                                 </StackPanel>

                                 <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Command="{Binding #GroupsTabRoot.((vm:GradebookViewModel)DataContext).OpenEditGroupModalCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="5" ToolTip.Tip="Edit Group">
                                       <TextBlock Classes="Icon" Text="{DynamicResource IconEdit}" FontSize="16" Foreground="{DynamicResource TextMainBrush}"/>
                                    </Button>
                                    <Button Command="{Binding #GroupsTabRoot.((vm:GradebookViewModel)DataContext).PromptDeleteGroupCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="5" ToolTip.Tip="Delete Group">
                                       <TextBlock Classes="Icon" Text="{DynamicResource IconDelete}" FontSize="16" Foreground="{DynamicResource DangerBrush}"/>
                                    </Button>
                                 </StackPanel>
                              </Grid>

                              <Border Height="1" Background="{DynamicResource BorderBrush}"/>

                              <!-- Member Rows (Individual Students & Crown Toggle) -->
                              <ItemsControl ItemsSource="{Binding Members}">
                                 <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                       <Grid ColumnDefinitions="Auto, *, 75, 58" Margin="0,4">
                                          
                                          <!-- Crown Toggle Button -->
                                          <Button Grid.Column="0" 
                                                  Command="{Binding ToggleLeaderCommand}" 
                                                  Background="Transparent" 
                                                  Padding="4,0,8,0" 
                                                  ToolTip.Tip="{Binding LeaderTooltipText}">
                                             <TextBlock Classes="Icon" 
                                                        Text="{DynamicResource IconCrown}" 
                                                        FontSize="18" 
                                                        Foreground="{Binding LeaderIconColor}"/>
                                          </Button>

                                          <!-- Name & Centralized Leader Badge -->
                                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                             <TextBlock Text="{Binding FullName}" ToolTip.Tip="{Binding FullName}" FontSize="12" Foreground="{DynamicResource TextMainBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                             <Border IsVisible="{Binding DbModel.IsLeader}" Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="Leader" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}"/>
                                             </Border>
                                          </StackPanel>
                                          
                                          <TextBox Grid.Column="2" Text="{Binding IndividualScoreDisplay}" Margin="4,0" HorizontalContentAlignment="Center"/>
                                          
                                          <Border Grid.Column="3" Background="{DynamicResource SurfaceVariantBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                             <TextBlock Text="{Binding TotalComputedGrade}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                          </Border>
                                       </Grid>
                                    </DataTemplate>
                                 </ItemsControl.ItemTemplate>
                              </ItemsControl>

                           </StackPanel>
                        </Border>
                     </DataTemplate>
                  </ItemsControl.ItemTemplate>
               </ItemsControl>
            </Panel>
         </ScrollViewer>

         <!-- Unassigned / Solo Students Drawer -->
         <Border Grid.Column="1" MinWidth="250" MaxWidth="400" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid RowDefinitions="Auto, *">
               <StackPanel Grid.Row="0" Margin="0,0,0,12">
                  <TextBlock Text="Unassigned Students" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextMainBrush}"/>
                  <TextBlock Text="Click '+ Solo' to create a 1-person group." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                  <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,0"/>
               </StackPanel>

               <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding UnassignedStudents}">
                     <ItemsControl.ItemTemplate>
                        <DataTemplate>
                           <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                              <TextBlock Grid.Column="0" Text="{Binding FullName}" ToolTip.Tip="{Binding FullName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMainBrush}"/>
                              <Button Grid.Column="1" Command="{Binding #GroupsTabRoot.((vm:GradebookViewModel)DataContext).AddSoloGroupCommand}" CommandParameter="{Binding}" Background="{DynamicResource SurfaceVariantBrush}" Padding="8,4" Margin="8,0,4,0" CornerRadius="6" ToolTip.Tip="Set as 1-person Solo Group">
                                 <TextBlock Text="+ Solo" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" FontWeight="Bold"/>
                              </Button>
                           </Grid>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>
               </ScrollViewer>
            </Grid>
         </Border>

      </Grid>

      <!-- Create Group Modal Dialog (Fixed Non-Overlapping Rows) -->
      <Border IsVisible="{Binding IsCreatingGroupModalOpen}" Background="#B3000000" ZIndex="100" Grid.RowSpan="2">
         <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Width="440" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #40000000">
            <Grid RowDefinitions="Auto, Auto, *, Auto">
               <TextBlock Grid.Row="0" Text="Create New Group" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,14"/>
               
               <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,10">
                  <StackPanel>
                     <TextBlock Text="Group Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                     <TextBox Text="{Binding NewGroupNameInput}"/>
                  </StackPanel>
                  <TextBlock Text="Select Members:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
               </StackPanel>

               <!-- Student Selection Checkboxes -->
               <ScrollViewer Grid.Row="2" Margin="0,0,0,16" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding CandidateMembers}">
                     <ItemsControl.ItemTemplate>
                        <DataTemplate>
                           <CheckBox IsChecked="{Binding IsSelected}" Margin="0,4">
                              <TextBlock Text="{Binding FullName}" FontSize="12" Margin="6,0,0,0"/>
                           </CheckBox>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>
               </ScrollViewer>

               <Grid Grid.Row="3" ColumnDefinitions="*, Auto, Auto">
                  <Button Grid.Column="1" Command="{Binding CancelCreateGroupCommand}" Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0"/>
                  <Button Grid.Column="2" Command="{Binding ConfirmCreateGroupCommand}" Content="Create" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Padding="20,10"/>
               </Grid>
            </Grid>
         </Border>
      </Border>

      <!-- Delete Group Modal -->
      <Border IsVisible="{Binding IsDeleteGroupModalOpen}" Background="#B3000000" ZIndex="100" Grid.RowSpan="2">
         <Border DataContext="{Binding DeleteGroupModal}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #40000000">
            <StackPanel>
               <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,15"/>
               <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,30"/>
               
               <Grid ColumnDefinitions="*, Auto, Auto">
                  <Button Grid.Column="1" Command="{Binding CancelCommand}" Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" FontWeight="Bold" Padding="20,10" Margin="0,0,15,0"/>
                  <Button Grid.Column="2" Command="{Binding ConfirmCommand}" Content="Delete Group" Background="{DynamicResource DangerBrush}" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="20,10"/>
               </Grid>
            </StackPanel>
         </Border>
      </Border>

      <!-- Edit Group Modal (Fixed Non-Overlapping Rows) -->
      <Border IsVisible="{Binding IsEditingGroupModalOpen}" Background="#B3000000" ZIndex="100" Grid.RowSpan="2">
         <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Width="440" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #40000000">
            <Grid RowDefinitions="Auto, Auto, *, Auto">
               <TextBlock Grid.Row="0" Text="Edit Group" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,14"/>
               
               <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,10">
                  <StackPanel>
                     <TextBlock Text="Group Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                     <TextBox Text="{Binding EditGroupNameInput}"/>
                  </StackPanel>
                  <TextBlock Text="Select Members:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
               </StackPanel>

               <!-- Student Selection Checkboxes -->
               <ScrollViewer Grid.Row="2" Margin="0,0,0,16" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding EditCandidateMembers}">
                     <ItemsControl.ItemTemplate>
                        <DataTemplate>
                           <CheckBox IsChecked="{Binding IsSelected}" Margin="0,4">
                              <TextBlock Text="{Binding FullName}" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="6,0,0,0"/>
                           </CheckBox>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>
               </ScrollViewer>

               <Grid Grid.Row="3" ColumnDefinitions="*, Auto, Auto">
                  <Button Grid.Column="1" Command="{Binding CancelEditGroupCommand}" Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0"/>
                  <Button Grid.Column="2" Command="{Binding ConfirmEditGroupCommand}" Content="Save Changes" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Padding="20,10"/>
               </Grid>
            </Grid>
         </Border>
      </Border>

      <!-- Copy Groups Modal -->
      <Border IsVisible="{Binding IsCopyGroupsModalOpen}" Background="#B3000000" ZIndex="100" Grid.RowSpan="2">
         <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #40000000">
            <StackPanel>
               <TextBlock Text="Copy Groups" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,12"/>
               <TextBlock Text="Select a previous assessment. All of its groups and members will be cloned into this assessment (grades will be reset to 0)." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

               <TextBlock Text="Copy From:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
               <ComboBox ItemsSource="{Binding CopyFromAssessments}" SelectedItem="{Binding SelectedCopyFromAssessment}" HorizontalAlignment="Stretch" Margin="0,0,0,25">
                  <ComboBox.ItemTemplate>
                     <DataTemplate>
                        <TextBlock Text="{Binding Title}"/>
                     </DataTemplate>
                  </ComboBox.ItemTemplate>
               </ComboBox>

               <Grid ColumnDefinitions="*, Auto, Auto">
                  <Button Grid.Column="1" Command="{Binding CancelCopyGroupsCommand}" Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0"/>
                  <Button Grid.Column="2" Command="{Binding ConfirmCopyGroupsCommand}" Content="Copy Now" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Padding="20,10"/>
               </Grid>
            </StackPanel>
         </Border>
      </Border>

      <Border IsVisible="{Binding IsProcessing}" Background="#B3000000" ZIndex="999" Grid.RowSpan="2">
         <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 10 30 0 #40000000">
            <StackPanel Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">
               <ProgressBar IsIndeterminate="True" Width="150" Height="6" CornerRadius="3" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource AppBackground}"/>
               <TextBlock Text="Processing Action..." FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
         </Border>
      </Border>
   </Grid>
</UserControl>