<UserControl xmlns="https://github.com/avaloniaui"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:vm="using:Centriku.ViewModels"
   x:Class="Centriku.Views.Gradebook.GradesTabView"
   x:DataType="vm:GradebookViewModel"
   x:Name="GradesRootControl">

   <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid RowDefinitions="Auto, Auto, Auto, *">
         
         <StackPanel Grid.Row="0" Margin="40,30,40,20">
            <Grid ColumnDefinitions="1*, 1.5*">
               <StackPanel Grid.Column="0" Margin="0,0,20,0">
                  <TextBlock Text="{Binding ClassTitle}" TextWrapping="Wrap" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                  <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Viewing Grade For:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,10"/>
                        <ComboBox ItemsSource="{Binding TermViews}" SelectedItem="{Binding SelectedTermView}" Width="200" Background="{DynamicResource AppBackground}" CornerRadius="6" Margin="0,0,0,10"/>
                  </WrapPanel>
               </StackPanel>

               <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                  <Button Content="Export Excel" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,10" Margin="0,0,15,15" FontWeight="Bold">
                     <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                           <StackPanel Spacing="10" Width="260" Margin="10">
                                 <TextBlock Text="Export Options" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                 <TextBlock Text="Select official documents to generate:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>

                                 <StackPanel Margin="0,10,0,10">
                                    <CheckBox Content="NwSSU Class Record (Grades)" IsChecked="{Binding ExportClassRecord}" FontWeight="Bold"/>
                                    <CheckBox Content="NwSSU Class Attendance" IsChecked="{Binding ExportClassAttendance}" FontWeight="Bold"/>
                                 </StackPanel>

                                 <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,5"/>
                                 
                                 <TextBlock Text="Export Location:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                 <TextBlock Text="{Binding ExportFolderDisplay}" FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}"/>
                                 <Button Content="Change Folder..." Click="OnChangeExportFolderClicked" Background="{DynamicResource SurfaceVariantBrush}" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,5,0,0"/>

                                 <Button Command="{Binding ExportCsvCommand}" Content="💾 Confirm Export" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,15,0,0"/>
                           </StackPanel>
                        </Flyout>
                     </Button.Flyout>
                  </Button>

                  <Button Content="View Options" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontWeight="Bold" CornerRadius="8" Padding="20,10" Margin="0,0,15,15">
                        <Button.Flyout>
                           <Flyout Placement="BottomEdgeAlignedRight">
                              <Grid RowDefinitions="Auto, *" Width="250" MaxHeight="450" Margin="10">
                                    <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,10">
                                       <TextBlock Text="Student Details" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                       <CheckBox Content="Show Student ID" IsChecked="{Binding ShowStudentId}" Margin="10,0,0,0"/>
                                       <CheckBox Content="Show Last Name" IsChecked="{Binding ShowLastName}" Margin="10,0,0,0"/>
                                       <CheckBox Content="Show First Name" IsChecked="{Binding ShowFirstName}" Margin="10,0,0,0"/>
                                       <CheckBox Content="Show Midterm" IsChecked="{Binding ShowMidtermGrade}" IsVisible="{Binding IsSemesterAverageView}" Margin="10,0,0,0"/>
                                       <CheckBox Content="Show Final" IsChecked="{Binding ShowFinalTermGrade}" IsVisible="{Binding IsSemesterAverageView}" Margin="10,0,0,0"/>   
                                       <CheckBox Content="{Binding DynamicFinalColumnName, StringFormat='Show {0}'}" IsChecked="{Binding ShowFinalGrade}" Margin="10,0,0,0" />
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowAssessmentFilters}">
                                       <StackPanel>
                                          <TextBlock Text="Grading Columns" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,10"/>
                                          <ItemsControl ItemsSource="{Binding CategoryFilters}">
                                                <ItemsControl.ItemTemplate>
                                                   <DataTemplate>
                                                      <StackPanel Margin="0,0,0,15">
                                                            <CheckBox Content="{Binding CategoryName}" IsChecked="{Binding IsCategoryVisible}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                            <ItemsControl ItemsSource="{Binding Assessments}" Margin="20,5,0,0">
                                                               <ItemsControl.ItemTemplate>
                                                                  <DataTemplate>
                                                                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsVisible}" Margin="0,0,0,5"/>
                                                                  </DataTemplate>
                                                               </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                      </StackPanel>
                                                   </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                       </StackPanel>
                                    </ScrollViewer>
                              </Grid>
                           </Flyout>
                        </Button.Flyout>
                  </Button>

                  <Button Command="{Binding ToggleAddAssessmentCommand}" Content="Add Assessment" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" FontWeight="Bold" CornerRadius="8" Padding="20,10" Margin="0,0,15,15"/>
                  <Button Command="{Binding ToggleEnrollmentCommand}" Content="Enroll Students" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="20,10" Margin="0,0,0,15"/>
               </WrapPanel>
            </Grid>
            
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,0"/>
         </StackPanel>

         <Border Grid.Row="1" IsVisible="{Binding IsEnrolling}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="40,0,40,30">
            <Grid RowDefinitions="Auto, Auto, *, Auto">
               
               <TextBlock Grid.Row="0" Text="Select Students to Enroll" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,10"/>
               
               <!-- Filter Controls -->
               <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                  <StackPanel Margin="0,0,15,10">
                     <TextBlock Text="Year" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                     <ComboBox ItemsSource="{Binding EnrollmentYearFilters}" SelectedItem="{Binding SelectedEnrollmentYear}" Background="{DynamicResource AppBackground}" Width="120"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,15,10">
                     <TextBlock Text="Program" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                     <ComboBox ItemsSource="{Binding EnrollmentProgramFilters}" SelectedItem="{Binding SelectedEnrollmentProgram}" Background="{DynamicResource AppBackground}" Width="120"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,0,10">
                     <TextBlock Text="Status" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                     <ComboBox ItemsSource="{Binding EnrollmentStatusFilters}" SelectedItem="{Binding SelectedEnrollmentStatus}" Background="{DynamicResource AppBackground}" Width="120"/>
                  </StackPanel>
               </WrapPanel>

               <!-- Compact Student Cards -->
               <ScrollViewer Grid.Row="2" MaxHeight="400" Margin="0,0,0,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding AvailableStudents}">
                     
                     <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                           <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                     </ItemsControl.ItemsPanel>
                     
                     <ItemsControl.ItemTemplate>
                        <DataTemplate>
                           <!-- Student Card (Added Margin="0,0,10,10" to simulate the spacing) -->
                           <Border Background="{DynamicResource SurfaceVariantBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Width="300" Margin="0,0,10,10">
                              <Grid ColumnDefinitions="Auto, *">
                                 <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                 <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                       <TextBlock Text="{Binding StudentID}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                       <TextBlock Text="|" Foreground="{DynamicResource BorderBrush}" FontSize="12"/>
                                       <TextBlock Text="{Binding DbModel.Gender}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                       <TextBlock Text="{Binding DbModel.GradeYearLevel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                       <TextBlock Text="•" Foreground="{DynamicResource BorderBrush}" FontSize="11"/>
                                       <TextBlock Text="{Binding DbModel.Program}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                       <TextBlock Text="•" Foreground="{DynamicResource BorderBrush}" FontSize="11"/>
                                       <TextBlock Text="{Binding DbModel.SectionName}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    </StackPanel>
                                    
                                    <Border Background="{DynamicResource AppBackground}" CornerRadius="4" Padding="4,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                       <TextBlock Text="{Binding DbModel.EnrollmentStatus}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                 </StackPanel>
                              </Grid>
                           </Border>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>
               </ScrollViewer>

               <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                  <Button Command="{Binding ToggleEnrollmentCommand}" Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"/>
                  <Button Command="{Binding SaveEnrollmentCommand}" Content="Save Enrollment" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold"/>
               </StackPanel>
               
            </Grid>
         </Border>

         <Border Grid.Row="2" IsVisible="{Binding IsAddingAssessment}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="40,0,40,30">
            <Grid RowDefinitions="Auto, *, Auto">
               <TextBlock Grid.Row="0" Text="Create New Assessment Column" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,15"/>
               <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                  <StackPanel Margin="0,0,15,15" MinWidth="200">
                     <TextBlock Text="Title*" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                     <TextBox Text="{Binding NewAssessmentTitle}" PlaceholderText="e.g. Quiz 1" Background="{DynamicResource AppBackground}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,15,15" MinWidth="200">
                     <TextBlock Text="Grading Category*" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                     <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}" Background="{DynamicResource AppBackground}" HorizontalAlignment="Stretch" PlaceholderText="Select category...">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                     </ComboBox>
                  </StackPanel>
                  <StackPanel Margin="0,0,15,15" MinWidth="150">
                     <TextBlock Text="Grading Period*" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                     <ComboBox ItemsSource="{Binding GradingPeriods}" SelectedItem="{Binding NewAssessmentPeriod}" Background="{DynamicResource AppBackground}" HorizontalAlignment="Stretch"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,15,15" MinWidth="120">
                     <TextBlock Text="Max Score*" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                     <NumericUpDown Value="{Binding NewAssessmentMaxScore}" Minimum="1" Maximum="1000" Background="{DynamicResource AppBackground}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,15,15" MinWidth="150">
                     <TextBlock Text="Date Given" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                     <CalendarDatePicker SelectedDate="{Binding NewAssessmentDate}" Background="{DynamicResource AppBackground}" HorizontalAlignment="Stretch"/>
                  </StackPanel>
               </WrapPanel>
               <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                  <Button Command="{Binding ToggleAddAssessmentCommand}" Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"/>
                  <Button Command="{Binding SaveAssessmentCommand}" Content="Save Assessment" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold"/>
               </StackPanel>
            </Grid>
         </Border>

         <DataGrid x:Name="RosterGrid" Grid.Row="3" Margin="40,0,40,40" 
            ItemsSource="{Binding GradebookRows}" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" CurrentCellChanged="RosterGrid_CurrentCellChanged"
            GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CanUserSortColumns="True" CanUserResizeColumns="False"
            CornerRadius="8" MinHeight="300" FrozenColumnCount="3">
            <DataGrid.Columns>
               <DataGridTextColumn Header="Student ID" Binding="{Binding StudentID}" SortMemberPath="StudentID" CanUserSort="True" IsReadOnly="True" Width="Auto"/>
               <DataGridTextColumn Header="Last Name" Binding="{Binding StudentInfo.LastName}" SortMemberPath="StudentInfo.LastName" CanUserSort="True" IsReadOnly="True" Width="Auto"/>
               <DataGridTextColumn Header="First Name" Binding="{Binding StudentInfo.FirstName}" SortMemberPath="StudentInfo.FirstName" CanUserSort="True" IsReadOnly="True" Width="Auto"/>
               <DataGridTemplateColumn Header="Computed Grade Final,Midterm,Semester" SortMemberPath="FinalGradeNumeric" CanUserSort="True" IsReadOnly="True" Width="Auto">
                  <DataGridTemplateColumn.CellTemplate>
                     <DataTemplate>
                        <TextBlock Text="{Binding FinalGrade}" ToolTip.Tip="{Binding FinalGradeTooltip}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                     </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
               </DataGridTemplateColumn>
               <DataGridTemplateColumn Header="Actions" Width="120">
                  <DataGridTemplateColumn.CellTemplate>
                     <DataTemplate>
                        <Button Command="{Binding #GradesRootControl.((vm:GradebookViewModel)DataContext).RemoveStudentCommand}" CommandParameter="{Binding StudentInfo}" Background="Transparent" HorizontalAlignment="Center">
                           <TextBlock Classes="Icon" Text="❌" Foreground="#EF4444" FontSize="14"/>
                        </Button>
                     </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
               </DataGridTemplateColumn>
            </DataGrid.Columns>
         </DataGrid>
         
      </Grid>
   </ScrollViewer>

</UserControl>