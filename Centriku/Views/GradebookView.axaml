<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Centriku.ViewModels"
             x:Class="Centriku.Views.GradebookView"
             x:DataType="vm:GradebookViewModel">

    <Grid RowDefinitions="Auto, *">
        
        <StackPanel Grid.Row="0" Margin="40,30,40,20">
            <TextBlock Text="{Binding ClassTitle}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
            <TextBlock Text="Use the arrow keys or Enter to navigate cells quickly." 
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" FontSize="14"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Margin="40,10,40,30"
                  ItemsSource="{Binding Students}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource BorderBrush}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="LRN" Binding="{Binding Lrn}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Student Name" Binding="{Binding FullName}" IsReadOnly="True" Width="*"/>

                <DataGridTextColumn Header="Quiz 1" Binding="{Binding Quiz1}" Width="100"/>
                <DataGridTextColumn Header="Quiz 2" Binding="{Binding Quiz2}" Width="100"/>
                <DataGridTextColumn Header="Final Exam" Binding="{Binding FinalExam}" Width="120"/>

                <DataGridTemplateColumn Header="Total Grade" IsReadOnly="True" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ComputedGrade}"  FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Padding="12,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            
        </DataGrid>
    </Grid>
</UserControl>