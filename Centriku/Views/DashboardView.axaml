<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Centriku.ViewModels"
    x:Class="Centriku.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
    x:Name="RootControl">

    <!-- UI/UX MICRO-INTERACTIONS -->
    <UserControl.Styles>
        <Style Selector="Border.HoverCard">
            <Setter Property="Transitions">
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.2"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.HoverCard:pointerover">
            <Setter Property="Margin" Value="10,5,10,15"/>
            <Setter Property="BoxShadow" Value="0 10 20 0 #20000000"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style Selector="Button.WarningBtn, Button.CriticalBtn">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,15,12"/> 
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate><ContentPresenter Content="{TemplateBinding Content}" Background="Transparent" /></ControlTemplate>
            </Setter>
        </Style>
        
        <Style Selector="Border.AlertBorder">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        
        <!-- AMBER HOVER FOR AT-RISK -->
        <Style Selector="Button.WarningBtn:pointerover Border.AlertBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/> 
            <Setter Property="BoxShadow" Value="0 4 12 0 #33F59E0B"/>
        </Style>

        <!-- RED HOVER FOR FAILED -->
        <Style Selector="Button.CriticalBtn:pointerover Border.AlertBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/> 
            <Setter Property="BoxShadow" Value="0 4 12 0 #33EF4444"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        
        <!-- ROW 0: SPLIT-HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="24,24,24,20">
            <!-- LEFT HEADER: Title & KPIs -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Dashboard" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                
                <WrapPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <!-- Box 1: Active Classes -->
                    <Border Background="{DynamicResource SurfaceVariantBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15,10" MinWidth="130" Margin="0,0,15,10">
                        <StackPanel>
                            <TextBlock Text="Active Classes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding ActiveClasses}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Box 2: Inactive Classes -->
                    <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15,10" MinWidth="130" Margin="0,0,15,10">
                        <StackPanel>
                            <TextBlock Text="Inactive Classes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding InactiveClasses}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Box 3: Total Enrolled -->
                    <Border Background="{DynamicResource SurfaceVariantBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15,10" MinWidth="130" Margin="0,0,15,10">
                        <StackPanel>
                            <TextBlock Text="Total Enrolled" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding TotalStudents}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Box 4: Total System Students -->
                    <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15,10" MinWidth="130" Margin="0,0,15,10">
                        <StackPanel>
                            <TextBlock Text="Total Students" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding TotalSystemStudents}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- RIGHT HEADER: Global Filters -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="School Year" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}" Width="130" Background="{DynamicResource AppBackground}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Term" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableTerms}" SelectedItem="{Binding SelectedTerm}" Width="130" Background="{DynamicResource AppBackground}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Program" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailablePrograms}" SelectedItem="{Binding SelectedProgram}" Width="130" Background="{DynamicResource AppBackground}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ROW 1: MAIN CONTENT -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="24,0,24,24">
            <!-- QUICK ACCESS CARDS -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,20,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True"> 
                <Grid RowDefinitions="Auto, *" VerticalAlignment="Stretch">
                    <TextBlock Grid.Row="0" Text="Quick Access" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,15"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ClassCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="HoverCard" Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="12" Padding="15" Margin="10,10,10,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel MinWidth="220" MaxWidth="300">
                                            
                                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                                <TextBlock Grid.Column="0" Text="{Binding ProgramSectionDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="{DynamicResource AppBackground}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding FullTitle}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                                            
                                            <!-- Passed / At-Risk / Failed Counters -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,15">
                                                <Border Background="{DynamicResource SurfaceVariantBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} Total'}" Foreground="{DynamicResource TextMainBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Passed -->
                                                <Border IsVisible="{Binding HasPassed}" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding PassedCount, StringFormat='{}{0} Passed'}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- At-Risk -->
                                                <Border IsVisible="{Binding HasAtRisk}" Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding AtRiskCount, StringFormat='{}{0} At-Risk'}" Foreground="{DynamicResource WarningTextBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Failed -->
                                                <Border IsVisible="{Binding HasFailed}" Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding FailedCount, StringFormat='{}{0} Failed'}" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            
                                            <Grid ColumnDefinitions="*, *" Margin="0,0,0,0">
                                                <Button Grid.Column="0" Command="{Binding #RootControl.((vm:DashboardViewModel)DataContext).OpenGradebookCommand}" 
                                                        CommandParameter="{Binding}" Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                                                        CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0">
                                                    <TextBlock Text="Grades" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                </Button>
                                                <Button Grid.Column="1" Command="{Binding #RootControl.((vm:DashboardViewModel)DataContext).OpenAttendanceCommand}" 
                                                        CommandParameter="{Binding}" Background="Transparent" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" 
                                                        Foreground="{DynamicResource PrimaryBrush}" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0">
                                                    <TextBlock Text="Attendance" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: ALERTS PANEL -->
            <Grid Grid.Column="1" RowDefinitions="*, *" MinWidth="340" MaxWidth="400">
                
                <!-- TOP BOX: EARLY WARNINGS (At-Risk) -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20,20,5,20" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto, *">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <TextBlock Classes="Icon" Text="{DynamicResource IconEarlyWarning}" FontSize="18" Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="{Binding NeedsAttention, StringFormat='Early Warnings ({0})'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,15,0">
                                <ItemsControl ItemsSource="{Binding AttentionAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- COMPACT ALERT BUTTON -->
                                            <Button Classes="WarningBtn" Command="{Binding #RootControl.((vm:DashboardViewModel)DataContext).OpenStudentAlertCommand}" CommandParameter="{Binding}">
                                                <Border Classes="AlertBorder" Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="6" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding StudentName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ClassName}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding AbsencesText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock IsVisible="{Binding HasNoAlerts}" Text="No active warnings." Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,15,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- BOTTOM BOX: CRITICAL (Failed/Dropped) -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20,20,5,20" Margin="0,10,0,0" BorderBrush="#33EF4444" BorderThickness="1">
                    <Grid RowDefinitions="Auto, *">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <TextBlock Classes="Icon" Text="{DynamicResource IconAtRisk}" FontSize="18" Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="Critical Failures" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,15,0">
                                <ItemsControl ItemsSource="{Binding CriticalAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="CriticalBtn" Command="{Binding #RootControl.((vm:DashboardViewModel)DataContext).OpenStudentAlertCommand}" CommandParameter="{Binding}">
                                                <Border Classes="AlertBorder" Background="{DynamicResource DangerBgBrush}" CornerRadius="6" Padding="12,8" BorderBrush="{DynamicResource DangerBgBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding StudentName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ClassName}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding AbsencesText}" FontSize="11" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock IsVisible="{Binding HasNoCriticalAlerts}" Text="No critical failures." Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,15,0"/>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</UserControl>