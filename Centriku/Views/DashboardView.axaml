<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Centriku.ViewModels"
    x:Class="Centriku.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
    x:Name="RootControl">

    <Grid RowDefinitions="Auto, *">
        
        <StackPanel Grid.Row="0" Margin="40,30,40,15">
            <TextBlock Text="Welcome back, Instructor!" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
            
            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,15,0,0">
                <!-- KPI Card 1: Active Classes -->
                <Border Background="{DynamicResource SurfaceVariantBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,15" MinWidth="160">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,5">
                            <TextBlock Text="Active Classes" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveClasses}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <!-- KPI Card 2: Total Students -->
                <Border Background="{DynamicResource SurfaceVariantBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,15" MinWidth="160">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,5">
                            <TextBlock Text="Total Enrolled" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalStudents}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="40,0,40,20">
            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="School Year" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}" Width="160" Background="{DynamicResource AppBackground}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Term" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableTerms}" SelectedItem="{Binding SelectedTerm}" Width="160" Background="{DynamicResource AppBackground}"/>
                </StackPanel>
            </StackPanel>
            
            <Border Height="1" Background="{DynamicResource BorderBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="40,0,40,40">
            
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,20,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    ClipToBounds="True"> 
                
                <Grid RowDefinitions="Auto, *" VerticalAlignment="Stretch">
                    
                    <TextBlock Grid.Row="0" Text="Quick Access" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,15"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ClassCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="8" Padding="15" Margin="10,10,10,10"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FullTitle}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                            
                                            <TextBlock Text="{Binding ProgramSectionDisplay}" Foreground="{DynamicResource PrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,4,0,5"/>
                                            <TextBlock Text="{Binding StudentCountText}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                            
                                            <Grid ColumnDefinitions="*, *" Margin="0,0,0,0">
                                                <Button Grid.Column="0" Command="{Binding #RootControl.((vm:DashboardViewModel)DataContext).OpenGradebookCommand}" 
                                                        CommandParameter="{Binding}" Background="{DynamicResource PrimaryBrush}" Foreground="White" 
                                                        CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="Grades" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                
                                                <Button Grid.Column="1" Command="{Binding #RootControl.((vm:DashboardViewModel)DataContext).OpenAttendanceCommand}" 
                                                        CommandParameter="{Binding}" Background="Transparent" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" 
                                                        Foreground="{DynamicResource PrimaryBrush}" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="Attendance" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- EARLY WARNINGS PANEL -->
            <Border Grid.Column="1" MinWidth="320" MaxWidth="400" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                
                <!-- FIX 1: Replaced StackPanel with Grid so it stretches to fill all vertical space -->
                <Grid RowDefinitions="Auto, *">
                    
                    <!-- Title -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,15">
                        <TextBlock Classes="Icon" Text="{DynamicResource IconEarlyWarning}" FontSize="20" Foreground="#EF4444"/>
                        <TextBlock Text="{Binding NeedsAttention, StringFormat='Early Warnings ({0})'}" FontSize="18" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Content Area -->
                    <Grid Grid.Row="1">
                        <!-- FIX 2: Removed MaxHeight="400" and disabled horizontal scrolling -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AttentionAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,10"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <!-- FIX 3: Added TextTrimming to prevent long names from pushing the badges off-screen -->
                                                    <TextBlock Grid.Column="0" Text="{Binding StudentName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <Border IsVisible="{Binding !IsCritical}" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Classes="Icon" Text="{DynamicResource IconAtRisk}" FontSize="12" Foreground="#D97706"/>
                                                                <TextBlock Text="At-Risk" FontSize="10" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        
                                                        <Border IsVisible="{Binding IsCritical}" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Classes="Icon" Text="{DynamicResource IconCritical}" FontSize="12" Foreground="#DC2626"/>
                                                                <TextBlock Text="Critical" FontSize="10" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- FIX 4: Added TextWrapping="Wrap" so long class names stack neatly instead of overflowing -->
                                                <TextBlock Text="{Binding ClassName}" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding AbsencesText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,10" TextWrapping="Wrap"/>

                                                <!-- Decluttered Grades Display (From previous optimization) -->
                                                <ItemsControl ItemsSource="{Binding TermGrades}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1"/> 
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding TermLabel}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                                
                                                                <Grid HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding GradeDisplay}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" IsVisible="{Binding !IsFailing}"/>
                                                                    <TextBlock Text="{Binding GradeDisplay}" FontSize="13" FontWeight="Bold" Foreground="#EF4444" IsVisible="{Binding IsFailing}"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State Wrapper perfectly centered -->
                        <StackPanel IsVisible="{Binding HasNoAlerts}" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Classes="Icon" Text="{DynamicResource IconEmptyState}" FontSize="48" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="All students are currently passing!" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" FontSize="14" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
        
    </Grid>
</UserControl>