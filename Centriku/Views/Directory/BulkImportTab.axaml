<UserControl xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:Centriku.ViewModels"
x:Class="Centriku.Views.Directory.BulkImportTab"
x:DataType="vm:DirectoryViewModel">
            
<Grid RowDefinitions="Auto, *">
    
    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="24,20,24,15">
        <StackPanel Grid.Column="0">
            <TextBlock Text="Import Students" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
            <TextBlock Text="Upload an Excel/CSV file to instantly add hundreds of students." Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" FontSize="14"/>
        </StackPanel>
        
        <Button Grid.Column="1" Command="{Binding NavigateToSettingsCommand}" Background="{DynamicResource SurfaceVariantBrush}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" CornerRadius="8" Padding="15,10" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Import Settings" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,0,24,40" Spacing="20">
            
            <Border IsVisible="{Binding HasImportError}" Background="#3F1014" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="❌" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ImportSummaryMessage}" Foreground="#FECACA" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding !IsLoading}">
                <Border IsVisible="{Binding !HasStagedStudents}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="40" MaxWidth="600" HorizontalAlignment="Left">
                   <StackPanel Spacing="15" HorizontalAlignment="Center">
                         <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center"/>
                         <TextBlock Text="Select your CSV or Excel file to begin." FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                         <TextBlock Text="Centriku will check your data for errors before importing." Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                         <Button Click="OnImportCsvClicked" Content="Choose Data File" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Padding="20,10" CornerRadius="8" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                   </StackPanel>
                </Border>
            </StackPanel>

            <Border IsVisible="{Binding IsLoading}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="12" Padding="40" MaxWidth="600" HorizontalAlignment="Left">
                <StackPanel Spacing="15" HorizontalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/> 
                    <TextBlock Text="Processing File..." FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="Reading data and checking for duplicates. Please wait." Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding HasStagedStudents}" Spacing="16">
                <DataGrid ItemsSource="{Binding StagedStudents}" AutoGenerateColumns="False" IsReadOnly="False" 
                          GridLinesVisibility="All" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" 
                          CornerRadius="8" Height="420" RowHeight="36" HorizontalAlignment="Stretch">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Action" Width="110" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ImportStatus}" Foreground="#1A1A1A" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Student ID" Binding="{Binding DbModel.StudentID}" Width="120"/>
                        
                        <!-- Proportional Star Columns absorb extra table width -->
                        <DataGridTextColumn Header="Last Name" Binding="{Binding DbModel.LastName}" Width="1.4*" MinWidth="100"/>
                        <DataGridTextColumn Header="First Name" Binding="{Binding DbModel.FirstName}" Width="1.4*" MinWidth="100"/>
                        <DataGridTextColumn Header="Middle Name" Binding="{Binding DbModel.MiddleName}" Width="1*" MinWidth="80"/>
                        
                        <DataGridTextColumn Header="Suffix" Binding="{Binding DbModel.Suffix}" Width="65"/>
                        <DataGridTextColumn Header="Gender" Binding="{Binding DbModel.Gender}" Width="80"/>
                        <DataGridTextColumn Header="Year" Binding="{Binding DbModel.GradeYearLevel}" Width="85"/>
                        <DataGridTextColumn Header="Program" Binding="{Binding DbModel.Program}" Width="1.1*" MinWidth="85"/>
                        <DataGridTextColumn Header="Section" Binding="{Binding DbModel.SectionName}" Width="75"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding DbModel.EnrollmentStatus}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                    <Button Grid.Column="1" Command="{Binding CancelBulkImportCommand}" Content="Cancel &amp; Clear" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Padding="18,10" Margin="0,0,12,0"/>
                    
                    <Button Grid.Column="2" Command="{Binding RecheckStagedDataCommand}" Content="Re-Check Data" Background="{DynamicResource SurfaceVariantBrush}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" Padding="18,10" CornerRadius="8" Margin="0,0,12,0" ToolTip.Tip="Scans the table and updates any rows you edited."/>
                    
                    <Button Grid.Column="3" Command="{Binding ConfirmBulkImportCommand}" Content="Confirm &amp; Save to Directory" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Padding="22,10" CornerRadius="8"/>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Grid>
</UserControl>