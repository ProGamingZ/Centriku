<UserControl xmlns="https://github.com/avaloniaui"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:vm="using:Centriku.ViewModels"
   x:Class="Centriku.Views.Directory.BulkImportTab"
   x:DataType="vm:DirectoryViewModel">
             
   <StackPanel Margin="40,30,40,20">
      <TextBlock Text="Import Students" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
      <TextBlock Text="Upload an Excel/CSV file to instantly add hundreds of students." Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,20" FontSize="14"/>
      
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="40" MaxWidth="600" HorizontalAlignment="Left">
         <StackPanel Spacing="15" HorizontalAlignment="Center">
               <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center"/>
               <TextBlock Text="Drag and drop your .csv file here" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
               <TextBlock Text="or click below to browse your computer." Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
               <Button Click="OnImportCsvClicked" Content="Choose Data File" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Padding="20,10" CornerRadius="8" HorizontalAlignment="Center" Margin="0,10,0,0"/>
         </StackPanel>
      </Border>
   </StackPanel>

</UserControl>