<UserControl xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:Centriku.ViewModels"
x:Class="Centriku.Views.Directory.BulkImportTab"
x:DataType="vm:DirectoryViewModel">
            
<Grid RowDefinitions="Auto, *">
    
    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="24,20,24,15">
        <StackPanel Grid.Column="0">
            <TextBlock Text="Import Students" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
            <TextBlock Text="Upload an Excel/CSV file to instantly add hundreds of students." Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" FontSize="14"/>
        </StackPanel>
        
        <Button Grid.Column="1" Command="{Binding NavigateToSettingsCommand}" Background="{DynamicResource SurfaceVariantBrush}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" CornerRadius="8" Padding="15,10" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Import Settings" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,0,24,40" Spacing="20">
            
            <Border IsVisible="{Binding HasImportError}" Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="Icon" Text="{DynamicResource IconCritical}" Foreground="{DynamicResource DangerBrush}" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ImportSummaryMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Current Column Configuration &amp; Auto-Fill Defaults" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Click 'Import Settings' above to modify" FontStyle="Italic" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Contextual Auto-Fill Summary Pill Bar -->
                    <Border Background="{DynamicResource SurfaceVariantBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Grid.Column="0" Text="Auto-Fill for Blank/Ignored Cells:  " FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding AutoFillSummaryText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding CurrentSettingsPreview}" AutoGenerateColumns="False" IsReadOnly="True" 
                              CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" 
                              CornerRadius="8" RowHeight="38" HorizontalAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Col1H}" Binding="{Binding Col1Text}" Width="*" MinWidth="85"/>
                            <DataGridTextColumn Header="{Binding Col2H}" Binding="{Binding Col2Text}" Width="*" MinWidth="85"/>
                            <DataGridTextColumn Header="{Binding Col3H}" Binding="{Binding Col3Text}" Width="*" MinWidth="85"/>
                            <DataGridTextColumn Header="{Binding Col4H}" Binding="{Binding Col4Text}" Width="*" MinWidth="85"/>
                            <DataGridTextColumn Header="{Binding Col5H}" Binding="{Binding Col5Text}" Width="*" MinWidth="85"/>
                            <DataGridTextColumn Header="{Binding Col6H}" Binding="{Binding Col6Text}" Width="*" MinWidth="85"/>
                            <DataGridTextColumn Header="{Binding Col7H}" Binding="{Binding Col7Text}" Width="*" MinWidth="85"/>
                            <DataGridTextColumn Header="{Binding Col8H}" Binding="{Binding Col8Text}" Width="*" MinWidth="85"/>
                            <DataGridTextColumn Header="{Binding Col9H}" Binding="{Binding Col9Text}" Width="*" MinWidth="85"/>
                            <DataGridTextColumn Header="{Binding Col10H}" Binding="{Binding Col10Text}" Width="*" MinWidth="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- File Upload Dropzone -->
            <StackPanel IsVisible="{Binding !IsLoading}">
                <Border IsVisible="{Binding !HasStagedStudents}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="40" HorizontalAlignment="Stretch">
                   <StackPanel Spacing="12" HorizontalAlignment="Center">
                         <TextBlock Classes="Icon" Text="{DynamicResource IconExport}" FontSize="42" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                         <TextBlock Text="Select your CSV or Excel file to begin." FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Center"/>
                         <TextBlock Text="Centriku will check your data for errors and duplicates before importing." Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                         <Button Click="OnImportCsvClicked" Content="Choose Data File" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Padding="24,10" CornerRadius="8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                   </StackPanel>
                </Border>
            </StackPanel>

            <Border IsVisible="{Binding IsLoading}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="12" Padding="40" HorizontalAlignment="Stretch">
                <StackPanel Spacing="15" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="6" CornerRadius="3" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource AppBackground}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Processing File..." FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="Reading data and checking for duplicates. Please wait." Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding HasStagedStudents}" Spacing="16">
                <DataGrid ItemsSource="{Binding StagedStudents}" AutoGenerateColumns="False" IsReadOnly="False" 
                          CanUserResizeColumns="False" CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" 
                          CornerRadius="8" Height="420" RowHeight="40" HorizontalAlignment="Stretch">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Action" Width="135" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusColor}"
                                            BorderBrush="{Binding StatusBorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,4"
                                            Margin="6,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ImportStatus}"
                                                   ToolTip.Tip="{Binding ImportStatus}"
                                                   Foreground="{Binding StatusTextColor}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Student ID" Binding="{Binding DbModel.StudentID}" Width="1.1*" MinWidth="115"/>
                        <DataGridTextColumn Header="Last Name" Binding="{Binding DbModel.LastName}" Width="1.4*" MinWidth="115"/>
                        <DataGridTextColumn Header="First Name" Binding="{Binding DbModel.FirstName}" Width="1.4*" MinWidth="115"/>
                        <DataGridTextColumn Header="Middle Name" Binding="{Binding DbModel.MiddleName}" Width="1.1*" MinWidth="100"/>
                        <DataGridTextColumn Header="Suffix" Binding="{Binding DbModel.Suffix}" Width="75"/>
                        <DataGridTextColumn Header="Gender" Binding="{Binding DbModel.Gender}" Width="100"/>
                        <DataGridTextColumn Header="Year" Binding="{Binding DbModel.GradeYearLevel}" Width="95"/>
                        <DataGridTextColumn Header="Program" Binding="{Binding DbModel.Program}" Width="1*" MinWidth="95"/>
                        <DataGridTextColumn Header="Section" Binding="{Binding DbModel.SectionName}" Width="85"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding DbModel.EnrollmentStatus}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                    <Button Grid.Column="1" Command="{Binding CancelBulkImportCommand}" Content="Cancel &amp; Clear" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Padding="18,10" Margin="0,0,12,0"/>
                    <Button Grid.Column="2" Command="{Binding RecheckStagedDataCommand}" Content="Re-Check Data" Background="{DynamicResource SurfaceVariantBrush}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" Padding="18,10" CornerRadius="8" Margin="0,0,12,0" ToolTip.Tip="Scans the table and updates any rows you edited."/>
                    <Button Grid.Column="3" Command="{Binding ConfirmBulkImportCommand}" Content="Confirm &amp; Save to Directory" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Padding="22,10" CornerRadius="8"/>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Grid>
</UserControl>