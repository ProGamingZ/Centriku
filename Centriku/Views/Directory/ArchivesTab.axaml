<UserControl xmlns="https://github.com/avaloniaui"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:vm="using:Centriku.ViewModels"
   x:Class="Centriku.Views.Directory.ArchivesTab"
   x:DataType="vm:DirectoryViewModel"
   x:Name="ArchivesRoot">
       
   <Grid RowDefinitions="Auto, Auto, *">
      <StackPanel Grid.Row="0" Margin="24,20,24,15">
         <TextBlock Text="Archived Students" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
         <TextBlock Text="Students who have transferred or dropped out. Their historical records are preserved here." 
                  Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" FontSize="14"/>
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="24,0,24,20">
         <TextBox Grid.Column="0" Text="{Binding ArchiveSearchQuery}" 
                  PlaceholderText="Search archives by Student ID, Name, Program, or Section..." 
                  Background="{DynamicResource SurfaceBrush}" 
                  BorderBrush="{DynamicResource BorderBrush}" 
                  CornerRadius="8" Padding="15,10" MaxWidth="400" HorizontalAlignment="Left"/>
         
         <Button Grid.Column="1" Content="Columns ⚙️" 
                  Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" 
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="15,10" Margin="0,0,15,0">
               <Button.Flyout>
                  <Flyout>
                     <StackPanel Spacing="10" MinWidth="150">
                           <TextBlock Text="Toggle Columns" FontWeight="Bold" Margin="0,0,0,5"/>
                           <CheckBox Content="Student ID" IsChecked="{Binding ShowArchiveStudentIdColumn}"/>
                           <CheckBox Content="Last Name" IsChecked="{Binding ShowArchiveLastNameColumn}"/>
                           <CheckBox Content="First Name" IsChecked="{Binding ShowArchiveFirstNameColumn}"/>
                           <CheckBox Content="Middle Name" IsChecked="{Binding ShowArchiveMiddleNameColumn}"/>
                           <CheckBox Content="Suffix" IsChecked="{Binding ShowArchiveSuffixColumn}"/>
                           <CheckBox Content="Gender" IsChecked="{Binding ShowArchiveGenderColumn}"/>
                           <CheckBox Content="Year" IsChecked="{Binding ShowArchiveGradeYearLevelColumn}"/>
                           <CheckBox Content="Program" IsChecked="{Binding ShowArchiveProgramColumn}"/>
                           <CheckBox Content="Section" IsChecked="{Binding ShowArchiveSectionNameColumn}"/>
                           <CheckBox Content="Status" IsChecked="{Binding ShowArchiveEnrollmentStatusColumn}"/>
                     </StackPanel>
                  </Flyout>
               </Button.Flyout>
         </Button>
      </Grid>

      <DataGrid Grid.Row="2" Margin="24,0,24,24" ItemsSource="{Binding DisplayedArchivedStudents}" AutoGenerateColumns="False" 
               CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="True" IsReadOnly="True" 
               GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8" 
               RowHeight="36"
               MinHeight="250"
               HorizontalAlignment="Stretch" 
               VerticalAlignment="Stretch">
               <DataGrid.Columns>
                  
                  <DataGridTemplateColumn Header="Student ID" SortMemberPath="StudentID" Width="120" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowArchiveStudentIdColumn}">
                     <DataGridTemplateColumn.CellTemplate>
                           <DataTemplate>
                              <Panel Margin="8,0">
                                 <TextBlock Text="{Binding StudentID}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}"/>
                                 <TextBox Text="{Binding StudentID}" VerticalAlignment="Center" IsVisible="{Binding IsEditing}" Padding="5,2" MinHeight="0"/>
                              </Panel>
                           </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <!-- Flexible Star Columns -->
                  <DataGridTemplateColumn Header="Last Name" SortMemberPath="LastName" Width="1.4*" MinWidth="110" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowArchiveLastNameColumn}">
                     <DataGridTemplateColumn.CellTemplate>
                           <DataTemplate>
                              <Panel Margin="8,0">
                                 <TextBlock Text="{Binding LastName}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}"/>
                                 <TextBox Text="{Binding LastName}" VerticalAlignment="Center" IsVisible="{Binding IsEditing}" Padding="5,2" MinHeight="0"/>
                              </Panel>
                           </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  
                  <DataGridTemplateColumn Header="First Name" SortMemberPath="FirstName" Width="1.4*" MinWidth="110" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowArchiveFirstNameColumn}">
                     <DataGridTemplateColumn.CellTemplate>
                           <DataTemplate>
                              <Panel Margin="8,0">
                                 <TextBlock Text="{Binding FirstName}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}"/>
                                 <TextBox Text="{Binding FirstName}" VerticalAlignment="Center" IsVisible="{Binding IsEditing}" Padding="5,2" MinHeight="0"/>
                              </Panel>
                           </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  
                  <DataGridTemplateColumn Header="Middle Name" SortMemberPath="MiddleName" Width="1*" MinWidth="90" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowArchiveMiddleNameColumn}">
                     <DataGridTemplateColumn.CellTemplate>
                           <DataTemplate>
                              <Panel Margin="8,0">
                                 <TextBlock Text="{Binding MiddleName}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}"/>
                                 <TextBox Text="{Binding MiddleName}" VerticalAlignment="Center" IsVisible="{Binding IsEditing}" Padding="5,2" MinHeight="0"/>
                              </Panel>
                           </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="Suffix" SortMemberPath="Suffix" Width="70" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowArchiveSuffixColumn}">
                     <DataGridTemplateColumn.CellTemplate>
                           <DataTemplate>
                              <Panel Margin="6,0">
                                 <TextBlock Text="{Binding Suffix}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}"/>
                                 <TextBox Text="{Binding Suffix}" VerticalAlignment="Center" IsVisible="{Binding IsEditing}" Padding="5,2" MinHeight="0"/>
                              </Panel>
                           </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="Gender" SortMemberPath="Gender" Width="85" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowArchiveGenderColumn}">
                     <DataGridTemplateColumn.CellTemplate>
                           <DataTemplate>
                              <Panel Margin="6,0">
                                 <TextBlock Text="{Binding Gender}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}"/>
                                 <ComboBox SelectedItem="{Binding Gender}" IsVisible="{Binding IsEditing}" VerticalAlignment="Center" Padding="5,2" MinHeight="0" HorizontalAlignment="Stretch">
                                       <x:String>Male</x:String>
                                       <x:String>Female</x:String>
                                 </ComboBox>
                              </Panel>
                           </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="Year" SortMemberPath="GradeYearLevel" Width="90" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowArchiveGradeYearLevelColumn}">
                     <DataGridTemplateColumn.CellTemplate>
                           <DataTemplate>
                              <Panel Margin="6,0">
                                 <TextBlock Text="{Binding GradeYearLevel}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}"/>
                                 <TextBox Text="{Binding GradeYearLevel}" VerticalAlignment="Center" IsVisible="{Binding IsEditing}" Padding="5,2" MinHeight="0"/>
                              </Panel>
                           </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <!-- Flexible Program Column -->
                  <DataGridTemplateColumn Header="Program" SortMemberPath="Program" Width="1.1*" MinWidth="90" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowArchiveProgramColumn}">
                     <DataGridTemplateColumn.CellTemplate>
                           <DataTemplate>
                              <Panel Margin="8,0">
                                 <TextBlock Text="{Binding Program}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}"/>
                                 <TextBox Text="{Binding Program}" VerticalAlignment="Center" IsVisible="{Binding IsEditing}" Padding="5,2" MinHeight="0"/>
                              </Panel>
                           </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="Section" SortMemberPath="SectionName" Width="80" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowArchiveSectionNameColumn}">
                     <DataGridTemplateColumn.CellTemplate>
                           <DataTemplate>
                              <Panel Margin="6,0">
                                 <TextBlock Text="{Binding SectionName}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}"/>
                                 <TextBox Text="{Binding SectionName}" VerticalAlignment="Center" IsVisible="{Binding IsEditing}" Padding="5,2" MinHeight="0"/>
                              </Panel>
                           </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="Status" SortMemberPath="EnrollmentStatus" Width="105" IsVisible="{ReflectionBinding $parent[UserControl].DataContext.ShowArchiveEnrollmentStatusColumn}">
                     <DataGridTemplateColumn.CellTemplate>
                           <DataTemplate>
                              <Panel Margin="6,0">
                                 <TextBlock Text="{Binding EnrollmentStatus}" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}"/>
                                 <ComboBox SelectedItem="{Binding EnrollmentStatus}" IsVisible="{Binding IsEditing}" VerticalAlignment="Center" Padding="5,2" MinHeight="0" HorizontalAlignment="Stretch">
                                       <x:String>Regular</x:String>
                                       <x:String>Irregular</x:String>
                                       <x:String>Transferee</x:String>
                                 </ComboBox>
                              </Panel>
                           </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                                                                  
                  <DataGridTemplateColumn Header="Actions" Width="160" CanUserSort="False" IsReadOnly="True" CanUserReorder="False" CanUserResize="False">
                     <DataGridTemplateColumn.CellTemplate>
                           <DataTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                 <Button Command="{Binding #ArchivesRoot.((vm:DirectoryViewModel)DataContext).EditOrSaveStudentCommand}"
                                          CommandParameter="{Binding}"
                                          Background="Transparent" ToolTip.Tip="Edit/Save">
                                       <Panel>
                                          <TextBlock Classes="Icon" Text="{DynamicResource IconEdit}" Foreground="{DynamicResource TextMainBrush}" FontSize="15" IsVisible="{Binding !IsEditing}"/>
                                          <TextBlock Classes="Icon" Text="{DynamicResource IconSave}" Foreground="{DynamicResource TextMainBrush}" FontSize="15" IsVisible="{Binding IsEditing}"/>
                                       </Panel>
                                 </Button>
                                 
                                 <Button Command="{Binding #ArchivesRoot.((vm:DirectoryViewModel)DataContext).ViewProfileCommand}"
                                          CommandParameter="{Binding}"
                                          Background="Transparent" ToolTip.Tip="View Full Profile">
                                       <TextBlock Classes="Icon" Text="{DynamicResource IconPerson}" Foreground="{DynamicResource TextMainBrush}" FontSize="15"/>
                                 </Button>
                                 
                                 <Button Command="{Binding #ArchivesRoot.((vm:DirectoryViewModel)DataContext).RestoreStudentCommand}"
                                          CommandParameter="{Binding}"
                                          Background="Transparent" ToolTip.Tip="Restore Student">
                                       <TextBlock Classes="Icon" Text="{DynamicResource IconRestore}" Foreground="#10B981" FontSize="15"/>
                                 </Button>

                                 <Button Command="{Binding #ArchivesRoot.((vm:DirectoryViewModel)DataContext).DeleteStudentCommand}"
                                          CommandParameter="{Binding}"
                                          Background="Transparent" ToolTip.Tip="Permanently Delete">
                                       <TextBlock Classes="Icon" Text="{DynamicResource IconDelete}" Foreground="#EF4444" FontSize="15"/>
                                 </Button>
                              </StackPanel>
                           </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
               </DataGrid.Columns>
      </DataGrid>
   </Grid>
</UserControl>