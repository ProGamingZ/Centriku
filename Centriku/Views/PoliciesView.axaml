<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Centriku.ViewModels"
             x:Class="Centriku.Views.PoliciesView"
             x:DataType="vm:PoliciesViewModel"
             x:Name="RootControl">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto, *">     
            <StackPanel Grid.Row="0" Margin="40,30,40,20">
                <TextBlock Text="Grading Policies" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                <TextBlock Text="Build and manage your custom grading rubrics." 
                        Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" FontSize="14"/>
            </StackPanel>

            <WrapPanel Grid.Row="1" Margin="40,10,40,30">
                
                <Border Width="450" VerticalAlignment="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="25" Margin="0,0,25,25">
                    <StackPanel>
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                            <TextBlock Grid.Column="0" Text="Template Details" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding ResetFormCommand}" Content="+ New" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" Padding="8,4"/>
                        </Grid>
                        
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Template Name" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding TemplateName}" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}"/>
                        </StackPanel>
                        
                        <Grid ColumnDefinitions="1*, 1*, 1.5*" Margin="0,0,0,20">
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Passing Grade" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                                <NumericUpDown Value="{Binding PassingGrade}" Minimum="1" Maximum="100" ShowButtonSpinner="False" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                <TextBlock Text="Total Weight" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                                <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="15,7" VerticalAlignment="Stretch">
                                    <TextBlock Text="{Binding TotalWeight, StringFormat='{}{0}%'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Calculation Mode" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding AvailableCalculationModes}" SelectedItem="{Binding CalculationMode}" HorizontalAlignment="Stretch" Background="{DynamicResource AppBackground}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel IsVisible="{Binding IsFormulaMode}" Margin="0,0,0,25">
                            <TextBlock Text="Formula Base Value" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="Enter the minimum baseline percentage" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <NumericUpDown Value="{Binding NrfgBaseValue}" Minimum="0" Maximum="100" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}"/>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsBoundaryMode}" Margin="0,0,0,25">
                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Text="Grade Boundaries" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding AddBoundaryCommand}" Content="Add Band" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" Padding="8,4"/>
                            </Grid>

                            <Grid ColumnDefinitions="1*, 1*, 1.5*, Auto" Margin="0,0,0,5">
                                <TextBlock Grid.Column="0" Text="Min %" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="1" Text="Max %" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="2" Text="Label (e.g. A)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                            </Grid>

                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Boundaries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="1*, 1*, 1.5*, Auto" Margin="0,0,10,8">
                                                <NumericUpDown Grid.Column="0" Value="{Binding MinScore}" Minimum="0" Maximum="100" ShowButtonSpinner="False" Margin="0,0,5,0" Background="{DynamicResource AppBackground}"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding MaxScore}" Minimum="0" Maximum="100" ShowButtonSpinner="False" Margin="0,0,10,0" Background="{DynamicResource AppBackground}"/>
                                                <TextBox Grid.Column="2" Text="{Binding Label}" PlaceholderText="Label" Margin="0,0,10,0" Background="{DynamicResource AppBackground}"/>
                                                <Button Grid.Column="3" Command="{Binding #RootControl.((vm:PoliciesViewModel)DataContext).RemoveBoundaryCommand}" CommandParameter="{Binding}" Content="✕" Foreground="#EF4444" Background="Transparent" Padding="5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                        
                        <Button Command="{Binding SavePolicyCommand}" Content="Save Policy" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="15"/>                    
                    </StackPanel>
                </Border>

                <Border Width="500" VerticalAlignment="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="25" Margin="0,0,25,25">
                    <Grid RowDefinitions="Auto, Auto, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*, 130, 80" Margin="0,0,0,15">
                            <TextBlock Grid.Column="0" Text="CATEGORY NAME" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="WEIGHT (%)" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold" FontSize="12"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" MaxHeight="220" Margin="0,0,0,15">
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, 130, 80" Margin="0,0,0,15">
                                            <TextBox Grid.Column="0" Text="{Binding Name}" Margin="0,0,15,0" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding Weight}" Minimum="0" Maximum="100" Margin="0,0,15,0" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}"/>
                                            <Button Grid.Column="2" Command="{Binding #RootControl.((vm:PoliciesViewModel)DataContext).RemoveCategoryCommand}" CommandParameter="{Binding}" Content="Remove" Foreground="#EF4444" Background="Transparent" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="2" Command="{Binding AddCategoryCommand}" Content="Add Category" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" Margin="0,0,0,20"/>
                    </Grid>
                </Border>

                <Border Width="450" VerticalAlignment="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="25" Margin="0,0,25,25">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="Saved Templates" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,15"/>
                        
                        <ScrollViewer Grid.Row="1" MaxHeight="500" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SavedTemplates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,10,8">
                                            <Grid ColumnDefinitions="*, Auto, Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TemplateName}" Foreground="{DynamicResource TextMainBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding PassingGrade, StringFormat='Pass: {0}'}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12"/>
                                                </StackPanel>
                                                
                                                <Button Grid.Column="1" Command="{Binding #RootControl.((vm:PoliciesViewModel)DataContext).EditTemplateCommand}" CommandParameter="{Binding}" Content="Edit" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" Padding="10,5" Margin="0,0,5,0"/>
                                                <Button Grid.Column="2" Command="{Binding #RootControl.((vm:PoliciesViewModel)DataContext).DeleteTemplateCommand}" CommandParameter="{Binding}" Content="X" Background="Transparent" Foreground="#EF4444" FontWeight="Bold" Padding="10,5"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </WrapPanel>
        
        
        </Grid>
    </ScrollViewer>
</UserControl>