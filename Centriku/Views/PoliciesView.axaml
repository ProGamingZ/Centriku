<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Centriku.ViewModels"
             x:Class="Centriku.Views.PoliciesView"
             x:DataType="vm:PoliciesViewModel"
             x:Name="RootControl">
    <Grid>
        <Grid RowDefinitions="Auto, *">     
            
            <StackPanel Grid.Row="0" Margin="40,30,40,20">
                <TextBlock Text="Grading Policies" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                <TextBlock Text="Build and manage your custom grading rubrics." 
                        Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" FontSize="14"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,0"/>
            </StackPanel>

            <!-- Master-Detail Layout -->
            <Grid Grid.Row="1" ColumnDefinitions="350, *" Margin="40,10,40,30">
                
                <!-- LEFT SIDEBAR: Saved Templates -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,25,0">
                    <Grid RowDefinitions="Auto, *">
                        <StackPanel Grid.Row="0">
                            <Button Command="{Binding ResetFormCommand}" Content="Create New Template" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="15" Margin="0,0,0,20"/>
                            <TextBlock Text="Your Saved Templates" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,15"/>
                        </StackPanel>
                        
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SavedTemplates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding TemplateName}" Foreground="{DynamicResource TextMainBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding PassingGrade, StringFormat='Passing Grade: {0}%'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <Button Command="{Binding #RootControl.((vm:PoliciesViewModel)DataContext).EditTemplateCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="5" ToolTip.Tip="Edit Template">
                                                        <TextBlock Classes="Icon" Text="{DynamicResource IconEdit}" Foreground="{DynamicResource TextMutedBrush}" FontSize="18"/>
                                                    </Button>
                                                    <Button Command="{Binding #RootControl.((vm:PoliciesViewModel)DataContext).InitiateDeleteCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="5" ToolTip.Tip="Delete Template">
                                                        <TextBlock Classes="Icon" Text="{DynamicResource IconDelete}" Foreground="#EF4444" FontSize="18"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- RIGHT SIDE: Editor Canvas -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="25" MaxWidth="800" HorizontalAlignment="Left">
                        
                        <!-- Dynamic Editor Header -->
                        <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="8" Padding="20">
                            <TextBlock Text="{Binding EditorTitleText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                        </Border>

                        <!-- Template Details -->
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="25">
                            <StackPanel>
                                <TextBlock Text="Template Details" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,20"/>
                                
                                <Grid ColumnDefinitions="2*, 1*, 1*">
                                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                        <TextBlock Text="Template Name" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding TemplateName}" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                        <TextBlock Text="Passing Grade (%)" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                                        <NumericUpDown Value="{Binding PassingGrade}" Minimum="1" Maximum="100" ShowButtonSpinner="False" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Formula Base Value" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                                        <NumericUpDown Value="{Binding NrfgBaseValue}" Minimum="0" Maximum="100" ShowButtonSpinner="False" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}" ToolTip.Tip="The lowest possible percentage a student can receive (e.g., Base 50)"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Grading Categories -->
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="25">
                            <StackPanel>
                                <TextBlock Text="Grading Categories &amp; Weights" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,20"/>

                                <Grid ColumnDefinitions="*, 130, 80" Margin="0,0,0,15">
                                    <TextBlock Grid.Column="0" Text="CATEGORY NAME" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="WEIGHT (%)" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold" FontSize="12"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Categories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*, 130, 80" Margin="0,0,0,15">
                                                <TextBox Grid.Column="0" Text="{Binding Name}" Margin="0,0,15,0" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding Weight}" Minimum="0" Maximum="100" Margin="0,0,15,0" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}"/>
                                                <Button Grid.Column="2" Command="{Binding #RootControl.((vm:PoliciesViewModel)DataContext).RemoveCategoryCommand}" CommandParameter="{Binding}" Content="Remove" Foreground="#EF4444" Background="Transparent" HorizontalAlignment="Left"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Command="{Binding AddCategoryCommand}" 
                                        Content="+ Add Category" 
                                        Background="Transparent" 
                                        BorderBrush="{DynamicResource PrimaryBrush}" 
                                        BorderThickness="1" 
                                        Foreground="{DynamicResource PrimaryBrush}" 
                                        FontWeight="Bold" 
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Center" 
                                        CornerRadius="6" 
                                        Padding="10" 
                                        Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Action Bar -->
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="25">
                            <Grid ColumnDefinitions="*, Auto">
                                
                                <!-- Live Validation Text -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalWeight, StringFormat='Total Weight: {0}%'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                    <TextBlock IsVisible="{Binding !IsValidPolicy}" Text="Total weight must be 100% to save." Foreground="#EF4444" FontWeight="SemiBold" FontSize="12" Margin="0,5,0,0"/>
                                    <TextBlock IsVisible="{Binding IsValidPolicy}" Text="Weights are perfectly balanced!" Foreground="#10B981" FontWeight="SemiBold" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15">
                                    <Button IsVisible="{Binding IsEditing}" Command="{Binding ResetFormCommand}" Content="Cancel Edit" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold" Padding="20,15"/>
                                    <Button Command="{Binding SavePolicyCommand}" Content="{Binding SaveButtonText}" Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" Padding="30,15" CornerRadius="8"/>
                                </StackPanel>

                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- SAFE DELETE MODAL OVERLAY -->
        <Border IsVisible="{Binding IsDeleteModalOpen}" Background="#B3000000" ZIndex="100">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 10 30 0 #40000000">
                <StackPanel>
                    <TextBlock Text="{Binding DeleteModalTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding DeleteModalMessage}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,30"/>
                    
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <Button Grid.Column="1" Command="{Binding CancelDeleteCommand}" Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" FontWeight="Bold" Padding="20,10" Margin="0,0,15,0"/>
                        <Button Grid.Column="2" IsVisible="{Binding CanConfirmDelete}" Command="{Binding ConfirmDeleteCommand}" Content="Delete Permanently" Background="#EF4444" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="20,10"/>
                        <Button Grid.Column="2" IsVisible="{Binding !CanConfirmDelete}" Command="{Binding CancelDeleteCommand}" Content="Understood" Background="{DynamicResource SurfaceVariantBrush}" Foreground="{DynamicResource TextMainBrush}" FontWeight="Bold" CornerRadius="8" Padding="20,10"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- PROCESSING SPINNER OVERLAY -->
        <Border IsVisible="{Binding IsProcessing}" Background="#B3000000" ZIndex="999">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 10 30 0 #40000000">
                <StackPanel Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="150" Height="6" CornerRadius="3" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource AppBackground}"/>
                    <TextBlock Text="Processing Action..." FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>