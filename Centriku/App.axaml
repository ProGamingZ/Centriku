<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Centriku"
             xmlns:conv="using:Centriku.Converters"
             x:Class="Centriku.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        
        <!-- 1. ICON TYPOGRAPHY                                    -->
        <Style Selector="TextBlock.Icon">
            <Setter Property="FontFamily" Value="{DynamicResource FluentIcons}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 2. DATAGRID (TABLES: ALT, HOVER, SELECTED, FOCUSED)   -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- Even & Odd Alternating Rows -->
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
        </Style>
        <Style Selector="DataGridRow:nth-child(odd)">
            <Setter Property="Background" Value="{DynamicResource DataGridAltRowBrush}"/> 
        </Style>

        <!-- Row Hover & Selected States -->
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource DataGridHoverBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle, 
                         DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource DataGridSelectedBrush}"/>
            <Setter Property="Opacity" Value="1"/> 
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
        </Style>

        <!-- Cell Focus State (Clean Primary Inner Ring when navigating/editing cells) -->
        <Style Selector="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputFocusBgBrush}"/>
        </Style>

        <!-- Column Headers with Pronounced Bottom & Side Borders -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_ColumnHeaderRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*, Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <ContentPresenter Grid.Column="0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>

                            <Path Name="SortArrow"
                                  Grid.Column="1"
                                  Width="8" Height="8"
                                  Margin="6,0,0,0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  IsVisible="False"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover /template/ Border#PART_ColumnHeaderRoot">
            <Setter Property="Background" Value="{DynamicResource DataGridHoverBrush}"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pressed /template/ Border#PART_ColumnHeaderRoot">
            <Setter Property="Background" Value="{DynamicResource DataGridSelectedBrush}"/>
        </Style>
        <Style Selector="DataGridColumnHeader:sortascending /template/ Path#SortArrow">
            <Setter Property="IsVisible" Value="True"/>
            <Setter Property="Data" Value="M 0,8 L 4,0 L 8,8 Z"/>
        </Style>
        <Style Selector="DataGridColumnHeader:sortdescending /template/ Path#SortArrow">
            <Setter Property="IsVisible" Value="True"/>
            <Setter Property="Data" Value="M 0,0 L 8,0 L 4,8 Z"/>
        </Style>

        <!-- 3. INPUT FIELDS (TEXTBOX & NUMERICUPDOWN)             -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="White"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource InputFocusBgBrush}"/>
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="NumericUpDown:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
        </Style>
        <Style Selector="NumericUpDown:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <!-- Hide internal scrollbars inside single-line TextBoxes (removes the gray pill on cell edit) -->
        <Style Selector="TextBox">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
        </Style>

        <!-- Frameless Inline Cell Editor (Eliminates curved inner box inside DataGrid cells) -->
        <Style Selector="DataGridCell TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="DataGridCell TextBox:pointerover /template/ Border#PART_BorderElement,
                         DataGridCell TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 4. DROPDOWNS (COMBOBOX & COMBOBOXITEM)                -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background, ComboBox:pressed /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DataGridHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DataGridSelectedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 5. BUTTONS, RADIOBUTTONS, CHECKBOXES, TOGGLESWITCHES  -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.93"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
            <Setter Property="Opacity" Value="0.86"/>
        </Style>

        <!-- RadioButton (Radial Buttons) -->
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="RadioButton /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Fill" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
        </Style>
        <Style Selector="RadioButton:pointerover /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Fill" Value="{DynamicResource SurfaceVariantBrush}"/>
        </Style>
        <Style Selector="RadioButton:checked /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stroke" Value="White"/>
        </Style>

        <!-- CheckBox -->
        <Style Selector="DataGrid CheckBox">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="White"/>
        </Style>

        <!-- ToggleSwitch -->
        <Style Selector="ToggleSwitch">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <!-- 6. NON-OVERLAPPING, THEME-STYLIZED SCROLLBARS         -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <Style Selector="DataGrid /template/ ScrollBar#PART_VerticalScrollbar">
            <Setter Property="AllowAutoHide" Value="False"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10"/>
            <Setter Property="MinHeight" Value="10"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBrush}"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="ScrollBar:pointerover /template/ Thumb,
                         ScrollBar /template/ Thumb:pointerover,
                         ScrollBar /template/ Thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
        </Style>
        <Style Selector="ScrollBar:pointerover /template/ Thumb /template/ Border,
                         ScrollBar /template/ Thumb:pointerover /template/ Border,
                         ScrollBar /template/ Thumb:pressed /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </Application.Styles>

    <!-- CENTRALIZED DESIGN TOKENS (LIGHT & DARK PALETTES)         -->
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="FluentIcons">avares://Centriku/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>
            <conv:SafeDoubleConverter x:Key="SafeDoubleConverter"/>
            <ResourceDictionary.ThemeDictionaries>

                <!-- DARK THEME: Deep Obsidian-Slate (Rich, Non-Neon, Pronounced Edges) -->
                <!-- DARK THEME: NwSSU Deep Forest-Obsidian & Warm Amber-Orange -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground">#09140E</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceBrush">#112218</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceVariantBrush">#193124</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="InputBgBrush">#0C1A12</SolidColorBrush>
                    <SolidColorBrush x:Key="InputFocusBgBrush">#142E20</SolidColorBrush>

                    <SolidColorBrush x:Key="TextMainBrush">#F2F9F5</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMutedBrush">#86A895</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="BorderBrush">#234231</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderStrongBrush">#346148</SolidColorBrush>
                    
                    <!-- NwSSU Emerald-Green Primary & Tinted Badges -->
                    <SolidColorBrush x:Key="PrimaryBrush">#16A34A</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryHoverBrush">#22C55E</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryBgBrush">#2616A34A</SolidColorBrush>

                    <!-- NwSSU Calculated Columns: Teal (TS) & NwSSU Orange-Gold (WS) -->
                    <SolidColorBrush x:Key="TsColumnBrush">#2DD4BF</SolidColorBrush>
                    <SolidColorBrush x:Key="WsColumnBrush">#FB923C</SolidColorBrush>

                    <SolidColorBrush x:Key="InfoBrush">#38BDF8</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoBgBrush">#2238BDF8</SolidColorBrush>

                    <!-- Table Row States (Zebra, Hover, Selected) -->
                    <SolidColorBrush x:Key="DataGridAltRowBrush">#0D1B13</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridHoverBrush">#1C3829</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridSelectedBrush">#1E4631</SolidColorBrush>

                    <SolidColorBrush x:Key="ScrollBarThumbBrush">#346148</SolidColorBrush>
                    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush">#22C55E</SolidColorBrush>
                    <SolidColorBrush x:Key="ScrollBarThumbFill">#346148</SolidColorBrush>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver">#22C55E</SolidColorBrush>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed">#16A34A</SolidColorBrush>

                    <!-- Semantic Status Tokens (Warning uses NwSSU Orange) -->
                    <SolidColorBrush x:Key="SuccessBrush">#22C55E</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessBgBrush">#2222C55E</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="WarningBrush">#F97316</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningTextBrush">#FB923C</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBgBrush">#24F97316</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="DangerBrush">#F43F5E</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerBgBrush">#22F43F5E</SolidColorBrush>
                </ResourceDictionary> 

                <!-- LIGHT THEME: NwSSU Institutional Forest Green, Vibrant Orange & Crisp White -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground">#EFF5F1</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceVariantBrush">#E3EFE7</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="InputBgBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="InputFocusBgBrush">#F0FDF4</SolidColorBrush>

                    <SolidColorBrush x:Key="TextMainBrush">#0D1F14</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMutedBrush">#3F5A49</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="BorderBrush">#C5D8CC</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderStrongBrush">#86A893</SolidColorBrush>
                    
                    <!-- NwSSU Institutional Forest Green Primary -->
                    <SolidColorBrush x:Key="PrimaryBrush">#166534</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryHoverBrush">#15803D</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryBgBrush">#1F166534</SolidColorBrush>

                    <!-- NwSSU Calculated Columns: Deep Teal (TS) & NwSSU Vibrant Orange (WS) -->
                    <SolidColorBrush x:Key="TsColumnBrush">#0F766E</SolidColorBrush>
                    <SolidColorBrush x:Key="WsColumnBrush">#EA580C</SolidColorBrush>

                    <SolidColorBrush x:Key="InfoBrush">#0284C7</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoBgBrush">#1F0284C7</SolidColorBrush>
                    
                    <!-- Table Row States (Zebra, Hover, Selected) -->
                    <SolidColorBrush x:Key="DataGridAltRowBrush">#F4F9F5</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridHoverBrush">#E3EFE7</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridSelectedBrush">#DCFCE7</SolidColorBrush>

                    <SolidColorBrush x:Key="ScrollBarThumbBrush">#86A893</SolidColorBrush>
                    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush">#166534</SolidColorBrush>
                    <SolidColorBrush x:Key="ScrollBarThumbFill">#86A893</SolidColorBrush>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver">#15803D</SolidColorBrush>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed">#166534</SolidColorBrush>

                    <!-- Semantic Status Tokens (Warning uses NwSSU Orange) -->
                    <SolidColorBrush x:Key="SuccessBrush">#15803D</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessBgBrush">#1F15803D</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="WarningBrush">#EA580C</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningTextBrush">#C2410C</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBgBrush">#1FEA580C</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="DangerBrush">#DC2626</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerBgBrush">#1FDC2626</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries> 

            <x:String x:Key="IconBooks">&#984067;</x:String>
            <x:String x:Key="IconGrades">&#986082;</x:String>
            <x:String x:Key="IconAttendance">&#983345;</x:String>
            <x:String x:Key="IconEarlyWarning">&#984015;</x:String>
            <x:String x:Key="IconEmptyState">&#62106;</x:String>
            <x:String x:Key="IconAtRisk">&#983130;</x:String>
            <x:String x:Key="IconCritical">&#62319;</x:String>

            <x:String x:Key="IconDashboard">&#62563;</x:String>
            <x:String x:Key="IconClasses">&#62154;</x:String>
            <x:String x:Key="IconPolicies">&#983182;</x:String>
            <x:String x:Key="IconDirectory">&#62901;</x:String>
            <x:String x:Key="IconSettings">&#63146;</x:String>

            <x:String x:Key="IconEdit">&#58804;</x:String>
            <x:String x:Key="IconSave">&#984441;</x:String>
            <x:String x:Key="IconDelete">&#62287;</x:String>
            <x:String x:Key="IconSearch">&#63120;</x:String>
            <x:String x:Key="IconExport">&#58599;</x:String>
            <x:String x:Key="IconTheme">&#58450;</x:String>
            <x:String x:Key="IconPerson">&#62912;</x:String>
            <x:String x:Key="IconArchive">&#61756;</x:String>
            <x:String x:Key="IconRestore">&#57577;</x:String>
            <x:String x:Key="IconCrown">&#xf020f;</x:String>
            <x:String x:Key="IconDuplicate">&#xF382;</x:String>
        </ResourceDictionary>
    </Application.Resources>

</Application>