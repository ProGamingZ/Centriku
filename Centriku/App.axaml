<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Centriku"
             xmlns:conv="using:Centriku.Converters"
             x:Class="Centriku.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        
        <Style Selector="TextBlock.Icon">
            <Setter Property="FontFamily" Value="{DynamicResource FluentIcons}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="DataGridColumnHeader:pointerover /template/ Grid#PART_ColumnHeaderRoot">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pressed /template/ Grid#PART_ColumnHeaderRoot">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style Selector="DataGridRow:nth-child(odd)">
            <Setter Property="Background" Value="{DynamicResource DataGridAltRowBrush}"/> 
        </Style>
        <Style Selector="DataGridRow:pointerover, DataGridRow:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource DataGridHoverBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle, 
                         DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource DataGridSelectedBrush}"/>
            <Setter Property="Opacity" Value="1"/> 
        </Style>
        <Style Selector="DataGridCell:selected, DataGridCell:pointerover, DataGridCell:selected:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <Style Selector="DataGridCell">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        
        <Style Selector="DataGrid CheckBox">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_ColumnHeaderRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*, Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <ContentPresenter Grid.Column="0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>

                            <Path Name="SortArrow"
                                  Grid.Column="1"
                                  Width="8" Height="8"
                                  Margin="6,0,0,0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="{TemplateBinding Foreground}"
                                  IsVisible="False"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover /template/ Border#PART_ColumnHeaderRoot">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pressed /template/ Border#PART_ColumnHeaderRoot">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <!-- Ascending -->
        <Style Selector="DataGridColumnHeader:sortascending /template/ Path#SortArrow">
            <Setter Property="IsVisible" Value="True"/>
            <Setter Property="Data" Value="M 0,8 L 4,0 L 8,8 Z"/>
        </Style>
        <!-- Descending -->
        <Style Selector="DataGridColumnHeader:sortdescending /template/ Path#SortArrow">
            <Setter Property="IsVisible" Value="True"/>
            <Setter Property="Data" Value="M 0,0 L 8,0 L 4,8 Z"/>
        </Style>

        <!-- CENTRALIZED CHECKBOX THEME (Selected & Unselected)    -->
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="White"/>
        </Style>

        <!-- NON-OVERLAPPING, THEME-STYLIZED SCROLLBARS            -->
        <!-- Disables overlay mode so scrollbars reserve their own space and NEVER cover table cells -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <Style Selector="DataGrid /template/ ScrollBar#PART_VerticalScrollbar">
            <Setter Property="AllowAutoHide" Value="False"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10"/>
            <Setter Property="MinHeight" Value="10"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBrush}"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="ScrollBar:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
        </Style>
        <!-- Hide bulky up/down scrollbar line buttons for a modern clean track -->
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="FluentIcons">avares://Centriku/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>
            <conv:SafeDoubleConverter x:Key="SafeDoubleConverter"/>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground">#0A0F1C</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceBrush">#151A28</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMainBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMutedBrush">#8A94A6</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderBrush">#2A2A35</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryBrush">#8B5CF6</SolidColorBrush> 

                    <SolidColorBrush x:Key="SurfaceVariantBrush">#1E2538</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridAltRowBrush">#0D1324</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridHoverBrush">#1E2538</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridSelectedBrush">#2B214D</SolidColorBrush>

                    <SolidColorBrush x:Key="SuccessBrush">#10B981</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessBgBrush">#1A10B981</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="WarningBrush">#F59E0B</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningTextBrush">#D97706</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBgBrush">#1AF59E0B</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="DangerBrush">#EF4444</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerBgBrush">#1AEF4444</SolidColorBrush>

                    <SolidColorBrush x:Key="ScrollBarThumbBrush">#334155</SolidColorBrush>
                    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush">#8B5CF6</SolidColorBrush>
                </ResourceDictionary> 

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground">#F3F4F6</SolidColorBrush> 
                    <SolidColorBrush x:Key="SurfaceBrush">#FFFFFF</SolidColorBrush>  
                    <SolidColorBrush x:Key="TextMainBrush">#111827</SolidColorBrush>   
                    <SolidColorBrush x:Key="TextMutedBrush">#4B5563</SolidColorBrush>   
                    <SolidColorBrush x:Key="BorderBrush">#CBD5E1</SolidColorBrush>   
                    <SolidColorBrush x:Key="PrimaryBrush">#8B5CF6</SolidColorBrush>  
                    
                    <SolidColorBrush x:Key="SurfaceVariantBrush">#E2E8F0</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridAltRowBrush">#F8FAFC</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridHoverBrush">#F3F4F6</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridSelectedBrush">#EDE9FE</SolidColorBrush>

                    <SolidColorBrush x:Key="SuccessBrush">#059669</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessBgBrush">#1A10B981</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="WarningBrush">#D97706</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningTextBrush">#B45309</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBgBrush">#1AF59E0B</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="DangerBrush">#DC2626</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerBgBrush">#1AEF4444</SolidColorBrush>

                    <SolidColorBrush x:Key="ScrollBarThumbBrush">#CBD5E1</SolidColorBrush>
                    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush">#8B5CF6</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries> 

            <x:String x:Key="IconBooks">&#984067;</x:String>
            <x:String x:Key="IconGrades">&#986082;</x:String>
            <x:String x:Key="IconAttendance">&#983345;</x:String>
            <x:String x:Key="IconEarlyWarning">&#984015;</x:String>
            <x:String x:Key="IconEmptyState">&#62106;</x:String>
            <x:String x:Key="IconAtRisk">&#983130;</x:String>
            <x:String x:Key="IconCritical">&#62319;</x:String>

            <x:String x:Key="IconDashboard">&#62563;</x:String>
            <x:String x:Key="IconClasses">&#62154;</x:String>
            <x:String x:Key="IconPolicies">&#983182;</x:String>
            <x:String x:Key="IconDirectory">&#62901;</x:String>
            <x:String x:Key="IconSettings">&#63146;</x:String>

            <x:String x:Key="IconEdit">&#58804;</x:String>
            <x:String x:Key="IconSave">&#984441;</x:String>
            <x:String x:Key="IconDelete">&#62287;</x:String>
            <x:String x:Key="IconSearch">&#63120;</x:String>
            <x:String x:Key="IconExport">&#58599;</x:String>
            <x:String x:Key="IconTheme">&#58450;</x:String>
            <x:String x:Key="IconPerson">&#62912;</x:String>
            <x:String x:Key="IconArchive">&#61756;</x:String>
            <x:String x:Key="IconRestore">&#57577;</x:String>
            <x:String x:Key="IconCrown">&#xf020f;</x:String>
            <x:String x:Key="IconDuplicate">&#xF382;</x:String>


        </ResourceDictionary>
    </Application.Resources>

</Application>