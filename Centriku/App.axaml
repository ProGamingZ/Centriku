<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Centriku"
             x:Class="Centriku.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground">#0A0F1C</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceBrush">#151A28</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMainBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMutedBrush">#8A94A6</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderBrush">#2A2A35</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryBrush">#8B5CF6</SolidColorBrush> 
                </ResourceDictionary> 

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground">#F5F5F5</SolidColorBrush> 
                    <SolidColorBrush x:Key="SurfaceBrush">#FFFFFF</SolidColorBrush>  
                    <SolidColorBrush x:Key="TextMainBrush">#1A1A1A</SolidColorBrush>   
                    <SolidColorBrush x:Key="TextMutedBrush">#666666</SolidColorBrush>   
                    <SolidColorBrush x:Key="BorderBrush">#E5E7EB</SolidColorBrush>   
                    <SolidColorBrush x:Key="PrimaryBrush">#8B5CF6</SolidColorBrush>     
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>   
        </ResourceDictionary>
    </Application.Resources>
</Application>